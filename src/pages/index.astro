---
import Navbar from '../components/Navbar.astro'
import Carousel from '../components/Carousel.astro';
import  SpeedInsights  from "@vercel/speed-insights/astro"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<!-- <link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"> -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,100..1000&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>Marek WEB</title>
    <style>
		.typing-effect {
			border-right: 2px solid;
			white-space: nowrap;
			overflow: hidden;
		}
		.heading-container {
			position: relative;
			color: white;
		}
		.heading-overlay {
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 88.8%;
			background: rgba(0, 0, 0, 0.2);
		}
		.heading-text {
			text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7); /* Text shadow */
		}
		.hero {
			position: relative;
			background: url('/indexbgCONSTRUCTION.jpeg');
			background-size: cover;
			background-position: center;
		}
		.hero::after {
			content: "";
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 2%; /* Adjust the height as needed */
			background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 1) 100%);
		}
    </style>
  </head>

  <SpeedInsights></SpeedInsights>

  <body>
    <section class="h-[700px] hero bg-cover bg-center flex flex-col heading-container">
      	<Navbar active={Astro.url.pathname}></Navbar>
      	<div class="h-[620px] mx-auto">
			<div class="heading-overlay flex justify-center items-center">
				<div class="text-white w-full max-w-[1280px] flex justify-end items-center h-full mx-3">
					<div class="md:text-end text-center xl:w-1/2 lg:w-2/3 md:w-4/5 w-full flex flex-col gap-8">
						<h1 class="text-6xl md:h-[120px] sm:h-[180px] sm:min-h-max min-h-[180px] heading-text font-light"><span id="changing-text" class=" font-medium typing-effect text-[color:var(--accent-color)]"></span> obytný dom podľa vašich predstáv</h1>
						<h3 class="text-3xl !text-slate-200 heading-text">Vlastný projekt <br> Hotový projekt <br> Naprojektovať architektom</h3>
						<div class="">
							<button id="contactButton" class="btn-main" role="button">Urobte to s nami!</button>
						</div>
					</div>
				</div>
			</div>
		</div>
    </section>
	<section class="mt-14 max-w-[1280px] mx-auto p-6">
		<div class="flex lg:flex-row flex-col gap-6 mx-6">
			<div class="flex flex-col items-center text-center gap-2">
				<img class="w-14" src="/users-alt.svg" alt="Our team ">
				<h3 class="text-3xl font-medium">Tím mladých a skúsených</h3>
				<p>
					Náš tím tvorí mix <b>mladých</b> novovyštudovaných a <b>skúsených</b> ľudí ktorý sú <b>entuziastický</b> k svojej práci
				</p>
			</div>
			<div class="flex flex-col items-center text-center gap-2">
				<img class="w-14" src="/time-fast.svg" alt="">
				<h3 class="text-3xl font-medium">Nekonkurenčná rýchlosť</h3>
				<p>
					Postavíme váš dom za nekonkurenčnú rýchlosť. Čas ktorý si stanovíme <b>musíme dodržať</b>, ináč podľa našej zmluvy <b>dostanete kompenzáciu</b>!
				</p>
			</div>
			<div class="flex flex-col items-center text-center gap-2">
				<img class="w-14" src="/hr-person.svg" alt="">
				<h3 class="text-3xl font-medium">Osobitný prístup</h3>
				<p>
					Ako rozrastajúca firma máme všetok priestor <b>len pre vás</b> a garantujeme <b>nadpriemerne</b> osobitný prístup
				</p>
			</div>
		</div>
	</section>

	<section class="max-w-[1280px] mx-auto mt-14 text-center">
		<h3 class="text-6xl mb-32">Naše projekty</h3>
		<Carousel></Carousel>
	</section>

	<section class="mb-[1000px]"></section>

    <script>
		const words = ["Postavíme", "Zrekonštrujeme", "Naprojektujeme"];
		let wordIndex = 0;
		let letterIndex = 0;
		const speed = 100;
		const changeInterval = 4000;

		const typingEffect = document.getElementById('changing-text');

		function typeWord() {
			if (letterIndex < words[wordIndex].length && typingEffect != null) {
				typingEffect.textContent += words[wordIndex].charAt(letterIndex);
				letterIndex++;
				setTimeout(typeWord, speed);
			} else {
				setTimeout(eraseWord, changeInterval);
			}
		}

		function eraseWord() {
			if (letterIndex > 0 && typingEffect != null) {
				typingEffect.textContent = words[wordIndex].substring(0, letterIndex - 1);
				letterIndex--;
				setTimeout(eraseWord, speed);
			} else {
				wordIndex = (wordIndex + 1) % words.length;
				setTimeout(typeWord, speed);
			}
		}

		document.addEventListener('DOMContentLoaded', (event) => {
			typeWord();
		});

		document.addEventListener('DOMContentLoaded', () => {
			const button = document.getElementById('contactButton');
			if (button) {
					button.addEventListener('click', () => {
					window.location.href = '/kontakt';
				});
			}
		});
    </script>
  </body>
</html>
