---
import Navbar from '../components/Navbar.astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<!-- <link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"> -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,100..1000&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>Marek WEB</title>
    <style>
		.typing-effect {
			border-right: 2px solid;
			white-space: nowrap;
			overflow: hidden;
		}
		.heading-container {
			position: relative;
			text-align: center;
			color: white;
		}
		.heading-overlay {
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 88.8%;
			background: rgba(0, 0, 0, 0.2);
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.heading-text {
			text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7); /* Text shadow */
		}
		.hero {
			position: relative;
			background: url('/indexbgCONSTRUCTION.jpeg');
			background-size: cover;
			background-position: center;
		}
		.hero::after {
			content: "";
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 2%; /* Adjust the height as needed */
			background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 1) 100%);
		}
    </style>
  </head>

  <body>
    <section class="h-[700px] hero bg-cover bg-center flex flex-col heading-container">
      	<Navbar active={Astro.url.pathname}></Navbar>
      	<div class="h-[620px] flex items-center mx-auto">
			<div class="flex justify-center flex-col sm:gap-8 gap-16 text-white text-center heading-overlay">
				<h1 class="text-6xl heading-text font-light"><span id="changing-text" class=" font-medium typing-effect text-[color:var(--accent-color)]"></span> obytný dom podľa vašich predstáv</h1>
				<div class="mx-auto">
					<button class="btn-main" role="button">Urobte to s nami!</button>
				</div>
			</div>
		</div>
    </section>
	<section class="mt-14 max-w-[1280px] mx-auto">
		<h2 class="text-5xl text-center">Čo ponúkame</h2>
		<div class="flex flex-row">
			<div>
				<!-- <img src="/workerNOBG.png" class="w-[20%]" alt="construction worker stock image"> -->
			</div>
			<div class="flex flex-row gap-6 mt-6 text-center">
				<div class="bg-[color:var(--primary-color)] rounded-lg py-2 px-4">
					<h3 class="text-3xl">Možnosť vystavby vlastneho projektu</h3>
				</div>
				<div class="bg-[color:var(--primary-color)] rounded-lg py-2 px-4">
					<h3 class="text-3xl">Možnosť návrhu projektu architektom</h3>
				</div>
				<div class="bg-[color:var(--primary-color)] rounded-lg py-2 px-4">
					<h3 class="text-3xl">Možnosť výberu projektu z example projektov</h3>
				</div>
			</div>
		</div>

	</section>

    <script>
      const words = ["Postavíme", "Zrekonštrujeme", "Naprojektujeme"];
      let wordIndex = 0;
      let letterIndex = 0;
      const speed = 100;
      const changeInterval = 4000;

      const typingEffect = document.getElementById('changing-text');

      function typeWord() {
        if (letterIndex < words[wordIndex].length && typingEffect != null) {
          typingEffect.textContent += words[wordIndex].charAt(letterIndex);
          letterIndex++;
          setTimeout(typeWord, speed);
        } else {
          setTimeout(eraseWord, changeInterval);
        }
      }

      function eraseWord() {
        if (letterIndex > 0 && typingEffect != null) {
          typingEffect.textContent = words[wordIndex].substring(0, letterIndex - 1);
          letterIndex--;
          setTimeout(eraseWord, speed);
        } else {
          wordIndex = (wordIndex + 1) % words.length;
          setTimeout(typeWord, speed);
        }
      }

      document.addEventListener('DOMContentLoaded', (event) => {
        typeWord();
      });
    </script>
  </body>
</html>
