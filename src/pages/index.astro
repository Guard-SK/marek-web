---
import Hero from '../components/Home/Hero.astro'
import About from '../components/Home/About.astro'
import Services from '../components/Home/Services.astro'
import Contact from '../components/Global/Contact.astro'
import Footer from '../components/Global/Footer.astro'
import Navbar from '../components/Global/Navbar.astro'
import Map from '../components/Global/Map.astro'
---

<!DOCTYPE html>
<html lang="sk">
  <head>
    <!-- Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Stavebná firma situovaná v Bratislave ktorá ponúka stavebné riešenie hrubej stavby, striech a iných konštrukčných riešení." />
    <meta name="generator" content="Astro" />
    <meta name="msvalidate.01" content="7504EE7B8C1B641BA886A62D6F85B168" />
  
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" sizes="180x180" href="/LogoAuroraConstruction.webp">
  
    <!-- Preload Critical Resources -->
    <link rel="preload" as="image" href="/HrubeStavbyHero.avif" />
    <link rel="preload" as="image" href="/favicon.svg" />
    <link rel="preload" as="image" href="/AboutImg.avif" />
  
    <!-- Preconnect for Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  
    <!-- Lazy-Load Fonts -->
    <link rel="preload" href="/fonts/oswald-v53-latin_latin-ext-700.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/fonts/oswald-v53-latin_latin-ext-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">

    <!-- Replace Astro import with this -->
    <link rel="preload" href="/styles/stylesheet.css" as="style">
    <link rel="stylesheet" href="/styles/stylesheet.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="/styles/stylesheet.css"></noscript>
    
    <link rel="preload" href="/styles/fonts.css" as="style">
    <link rel="stylesheet" href="/styles/fonts.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="/styles/fonts.css"></noscript> 
    
    <link rel="canonical" href="https://www.auroraconstruction.sk/" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Aurora Construction",
        "description": "Stavebná firma situovaná v Bratislave ktorá ponúka stavebné riešenie hrubej stavby, stiech, alebo iných stavebných riešení od odborníkov.",
        "url": "https://www.auroraconstruction.sk",
        "image": "https://www.auroraconstruction.sk/LogoBackground.png",
        "telephone": "+421 949 105 006",
        "email": "info@auroraconstruction.sk",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Nejedlého 27",
          "addressRegion": "Bratislavský kraj",
          "addressLocality": "Bratislava",
          "postalCode": "84102",
          "addressCountry": "SK"
        },
        "areaServed": {
          "@type": "Place",
          "name": "Slovensko"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+421 949 105 006",
          "name": "Marek Harcek",
          "areaServed": "Slovensko",
          "availableLanguage": ["slovenčina", "angličtina"],
          "description": "Hlavné kontaktné číslo na Mareka Harceka, spoluzakladateľa Aurora Construction."
        },
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Stavebné služby",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Hrubé stavby",
                "description": "Vytvorenie hrubej stavby od základov profesionálne a rýchlo."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Strechy na mieru",
                "description": "Profesionálne riešenie strechy presne podľa vašich potrieb."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Ostatné práce",
                "description": "Stavebné riešenia od pokladania zámkovej dlažby cez prácu s armatúrou po sadrokartonárske práce."
              }
            }
          ]
        },
        "sameAs": [
          "https://www.instagram.com/auroraconstruction_sk",
          "https://www.facebook.com/people/Aurora-Construction/61573155748091/"
        ]
      }
    </script>

    <style>
      #main-content {
        overflow-y: auto;
        height: 100vh;
      }
    </style>
    
    <!-- Title -->
    <title>Aurora Construction | Stavebná firma - Hrubá stavba, Strechy</title>
  </head>
  

  <body>
    <div id="main-content relative">
      <div class="absolute top-[-5%] left-[-15%] w-[800px] h-[800px]
      bg-gradient-radial from-[#63ffd3]/30 via-[#39c4ff]/10 to-transparent
      blur-[180px] z-10 pointer-events-none lg:block hidden"></div>

      <div class="absolute bottom-[5%] right-[-15%] w-[700px] h-[700px]
      bg-gradient-radial from-[#39c4ff]/20 via-[#63ffd3]/10 to-transparent
      blur-[200px] z-10 pointer-events-none"></div>

      <div class="absolute top-[40%] left-[-20%] w-[400px] h-[400px]
      bg-gradient-radial from-[#39c4ff]/15 via-[#63ffd3]/10 to-transparent
      blur-[150px] z-10 pointer-events-none"></div>

      <div class="absolute top-[30%] right-[-10%] w-[500px] h-[500px]
      bg-gradient-radial from-[#63ffd3]/25 via-[#39c4ff]/10 to-transparent
      blur-[160px] z-10 pointer-events-none"></div>

      <div class="absolute bottom-[20%] left-[-12%] w-[400px] h-[400px]
      bg-gradient-radial from-[#39c4ff]/15 via-[#63ffd3]/10 to-transparent
      blur-[150px] z-10 pointer-events-none"></div>

      <Navbar />
      <Hero />
      <About />
      <Services />
      <Map title='Pôsobíme v Bratislavskom a Trnavskom kraji' description="Zameriavame sa na výstavbu a elektroinštalácie v regiónoch, ktoré dôverne poznáme. To nám umožňuje garantovať rýchlu realizáciu, jednoduchú logistiku a osobný prístup." />
      <Contact />
      <Footer />
    </div>
  </body>
  
  
</html>
  
<script>
// Import GSAP and ScrollTrigger
function initGSAPAnimations() {
  import('../animations/services.js').then(({ animateServices }) => {
    animateServices();
  });
}

initGSAPAnimations();

</script>