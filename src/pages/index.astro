---
import Hero from '../components/Hero.astro'
import About from '../components/About.astro'
import Services from '../components/Services.astro'
import Hruba from '../components/Hruba.astro'
import StrechaHolodom from '../components/StrechaHolodom.astro'
import Contact from '../components/Contact.astro'
import Footer from '../components/Footer.astro'

import '../styles/stylesheet.css'
---

<!DOCTYPE html>
<html lang="sk">
  <head>
    <!-- Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Profesionálne stavebné riešenie hrubej stavby od odborníkov. V našej ponuke sú hrubé stavby a čoskoro aj strechy na mieru či holodom. Náš dôraz je hlavne na individuálny prístup k našim klientom a odbornom vyhotovení projektu. Hrubá stavba je naša expertíza" />
    <meta name="generator" content="Astro" />
  
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
    <!-- Preload Critical Resources -->
    <link rel="preload" as="image" href="/HolodomHero.avif" />
    <link rel="preload" as="image" href="/HrubeStavbyHero.avif" />
    <link rel="preload" as="image" href="/RoofHero.avif" />
  
    <!-- Preconnect for Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  
    <!-- Lazy-Load Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Aurora Construction",
        "description": "Profesionálne stavebné riešenie hrubej stavby od odborníkov. V našej ponuke sú hrubé stavby a čoskoro aj strechy na mieru či holodom. Náš dôraz je hlavne na individuálny prístup k našim klientom a odbornom vyhotovení projektu. Hrubá stavba je naša expertíza.",
        "url": "https://www.aurora-constructions.sk",
        "telephone": "+421 903 164 540",
        "email": "info@yourwebsite.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Nejedlého 27",
          "addressLocality": "Bratislava",
          "addressCountry": "SK"
        },
        "areaServed": {
          "@type": "Place",
          "name": "Slovensko"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+421 903 164 540",
          "contactType": "osobný kontakt",
          "areaServed": "Slovensko",
          "availableLanguage": ["slovenčina", "angličtina"],
          "description": "Hlavné kontaktné číslo na Mareka Harceka, spoluzakladateľa Aurora."
        },
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Stavebné služby",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Hrubé stavby",
                "description": "Vytvorenie hrubej stavby od základov profesionálne a rýchlo."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Strechy na mieru",
                "description": "Profesionálne riešenie strechy presne podľa vašich potrieb."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Holodomy",
                "description": "Moderné a kvalitné holodomy pripravené na finálnu úpravu."
              }
            }
          ]
        }
      }
    </script>    
      
    <!-- Title -->
    <title>Aurora Constructions | Stavebná firma</title>
  </head>
  

  <body>
	<Hero></Hero>
	<About></About>
	<Services></Services>
	<Hruba></Hruba>
	<StrechaHolodom></StrechaHolodom>
	<Contact></Contact>
  <Footer></Footer>
  </body>
</html>
  
<script>
document.addEventListener('DOMContentLoaded', () => {
    const scrollElements = document.querySelectorAll('.scroll-reveal');
  
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          } else {
            entry.target.classList.remove('visible'); // Optional: Remove for repeated animations
          }
        });
      },
      {
        threshold: 0.3, // Trigger when 20% of the element is visible
      }
    );
  
    scrollElements.forEach((el) => observer.observe(el));
});
</script>