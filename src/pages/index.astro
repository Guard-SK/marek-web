    <style>
      .scroll-container {
        overflow-y: auto;
        height: 100vh;
      }

      .snap-section {
        scroll-snap-align: start;
        min-height: 100vh;
      }

      .snap-active {
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth;
      }

      #intro-animation {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background: linear-gradient(180deg, #000 50%, #02072f 100%);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        overflow: hidden;
      }

      #aurora {
        position: absolute;
        width: 200%;
        height: 120%;
        background: radial-gradient(circle, rgba(55, 212, 219, 0.5) 10%, transparent 70%),
                    radial-gradient(circle, rgba(56, 171, 211, 0.4) 20%, transparent 80%),
                    radial-gradient(circle, rgba(43, 69, 97, 0.3) 15%, transparent 85%);
        background-size: 150% 150%;
        animation: aurora-move 4.5s infinite alternate ease-in-out;
        filter: blur(30px);
        opacity: 0.9;
    }

      @keyframes aurora-move {
        0% {
          transform: translate(-20%, -15%) scale(1.2);
        }
        100% {
          transform: translate(60%, 20%) scale(1);
        }
      }

      #intro-content {
        position: relative;
        color: white;
        text-align: center;
        opacity: 0;
        animation: fade-in 1.5s 0.25s forwards;
      }

      @keyframes fade-in {
        from {
          opacity: 0;
          transform: scale(0.9);
        }
        to {
          opacity: 1;
          transform: scale(1.1);
        }
      }

      @keyframes text-scale {
        0%, 100% {
          transform: scale(0.9);
        }
        50% {
          transform: scale(1.1);
        }
      }

      #loading-dots-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
        opacity: 0;
        animation: fade-in 0.5s ease-in-out 2.5s forwards;
      }

      .loading-dot {
        width: 12px;
        height: 12px;
        background-color: #121212d0;
        border-radius: 50%;
        animation: dots-animation 1.5s infinite ease-in-out;
      }

      .loading-dot:nth-child(1) {
        animation-delay: 0s;
      }

      .loading-dot:nth-child(2) {
        animation-delay: 0.2s;
      }

      .loading-dot:nth-child(3) {
        animation-delay: 0.4s;
      }

      @keyframes dots-animation {
        0%, 80%, 100% {
          transform: scale(1);
          opacity: 0.5;
        }
        40% {
          transform: scale(1.3);
          opacity: 1;
        }
      }
    </style>
    
    <!-- Title -->
    <title>Aurora Construction | Stavebná firma - Hrubá stavba, Strechy</title>
  </head>
  

  <body>
    <div id="intro-animation">
      <div id="aurora"></div>
      <div id="intro-content" class="flex flex-col justify-center items-center mt-16">
        <div class="logo flex select-none justify-center gap-0 items-center text-4xl w-16 h-16 z-10 lg:h-32 lg:w-32 lg:text-7xl">
          <img src="/LogoAuroraConstruction.webp" alt="Aurora construction logo">
          <h4 class="text-[#d7d8d4]"><span style="display: none;">A</span>urora</h4>
        </div>
        <h2 class="text-white gradient-text text-6xl lg:text-9xl mt-1 pb-2 mb-2 font-extrabold !leading-[1.13] select-none">
          <span class="gradient-text-1">VAŠA STAVBA</span><br>
          <span class="gradient-text-2">NÁŠ ZÁVÄZOK</span>
        </h2>
        <div id="loading-dots-container">
          <div class="loading-dot"></div>
          <div class="loading-dot"></div>
          <div class="loading-dot"></div>
        </div>
      </div>
    </div>

    <div id="main-content" class="scroll-container" style="display: none;">
        <Hero />
        <About />
        <Services />
      <div id="hruba-stavba" class="snap-section">
        <Hruba />
      </div>
      <div id="roof-section" class="snap-section">
        <Roof />
      </div>
      <OtherJobs />
      <div id="contact-section" class="snap-section">
        <Contact />
      </div>
        <Footer />
    </div>
  </body>
  
  
</html>
  
<script>
document.addEventListener('DOMContentLoaded', () => {
  const scrollElements = document.querySelectorAll('.scroll-reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const target = entry.target as HTMLElement;
        if (entry.isIntersecting && !target.classList.contains('visible')) {
          target.classList.add('visible');
        }
      });
    },
    {
      threshold: 0.3,
    }
  );
  scrollElements.forEach((el) => observer.observe(el));
});


document.addEventListener('DOMContentLoaded', () => {
    const scrollContainer = document.querySelector('.scroll-container');
    const sectionsToSnap = [
      document.getElementById('hruba-stavba'),
      document.getElementById('roof-section'),
      document.getElementById('contact-section')
    ].filter(Boolean) as HTMLElement[];

    if (!scrollContainer || sectionsToSnap.length === 0) {
      console.error('Scroll container or sections to snap not found.');
      return;
    }

    let isButtonScrolling = false;

    document.addEventListener('buttonScrollStart', () => {
      isButtonScrolling = true;
    });

    document.addEventListener('buttonScrollEnd', () => {
      isButtonScrolling = false;
    });

    const observer = new IntersectionObserver(
      (entries) => {
        if (isButtonScrolling) return;
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            scrollContainer.scrollTo({
              top: target.offsetTop,
              behavior: 'smooth'
            });
          }
        });
      },
      { threshold: 0.3 }
    );

    sectionsToSnap.forEach((section) => observer.observe(section));
  });

  window.addEventListener("load", () => {
    const introAnimation = document.getElementById("intro-animation");
    const mainContent = document.getElementById("main-content");

    if (introAnimation && mainContent) {
      setTimeout(() => {
        introAnimation.style.transition = "opacity 1s";
        introAnimation.style.opacity = "0";
        setTimeout(() => {
          introAnimation.style.display = "none";
          mainContent.style.display = "block";
        }, 500); // Match the fade-out duration
      }, 1750); // Total duration of aurora animation
    }
  });
</script>