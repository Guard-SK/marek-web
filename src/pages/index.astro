---
import Navbar from '../components/Navbar.astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Marek WEB</title>
    <style>
		.typing-effect {
			border-right: 2px solid;
			white-space: nowrap;
			overflow: hidden;
		}
		.heading-container {
			position: relative;
			text-align: center;
			color: white;
		}
		.heading-overlay {
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 88.8%;
			background: rgba(0, 0, 0, 0.2); /* Semi-transparent overlay */
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.heading-text {
			font-size: 3em;
			font-weight: bold;
			text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7); /* Text shadow */
		}
		.hero {
			position: relative;
			background: url('../../public/indexbg.jpg');
			background-size: cover;
			background-position: center;
		}
		.hero::after {
			content: "";
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 2%; /* Adjust the height as needed */
			background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 1) 100%);
		}
    </style>
  </head>

  <body>
    <div class="h-[700px] hero bg-cover bg-center flex flex-col heading-container">
      	<Navbar active={Astro.url.pathname}></Navbar>
      	<div class="h-[620px] flex items-center mx-auto">
			<div class="flex justify-center flex-col sm:gap-8 gap-16 text-white text-center heading-overlay">
				<h1 class="text-6xl heading-text font-semibold"><span id="changing-text" class="typing-effect"></span> obytný dom podľa vašich predstáv</h1>
				<div class="mx-auto">
					<button class="btn-main" role="button">Urobte to s nami!</button>
				</div>
			</div>
		</div>
    </div>

    <script>
      const words = ["Postavíme", "Zrekonštrujeme", "Naprojektujeme"];
      let wordIndex = 0;
      let letterIndex = 0;
      const speed = 100;
      const changeInterval = 4000;

      const typingEffect = document.getElementById('changing-text');

      function typeWord() {
        if (letterIndex < words[wordIndex].length && typingEffect != null) {
          typingEffect.textContent += words[wordIndex].charAt(letterIndex);
          letterIndex++;
          setTimeout(typeWord, speed);
        } else {
          setTimeout(eraseWord, changeInterval);
        }
      }

      function eraseWord() {
        if (letterIndex > 0 && typingEffect != null) {
          typingEffect.textContent = words[wordIndex].substring(0, letterIndex - 1);
          letterIndex--;
          setTimeout(eraseWord, speed);
        } else {
          wordIndex = (wordIndex + 1) % words.length;
          setTimeout(typeWord, speed);
        }
      }

      document.addEventListener('DOMContentLoaded', (event) => {
        typeWord();
      });
    </script>
  </body>
</html>
