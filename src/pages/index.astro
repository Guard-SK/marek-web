---
import Hero from '../components/Home/Hero.astro'
import About from '../components/Home/About.astro'
import Services from '../components/Home/Services.astro'
import Contact from '../components/Global/Contact.astro'
import Footer from '../components/Global/Footer.astro'
import Navbar from '../components/Global/Navbar.astro'
import Map from '../components/Global/Map.astro'
---

<!DOCTYPE html>
<html lang="sk">
  <head>
    <!-- Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Stavebná firma  v Bratislave ktorá ponúka stavebné riešenie hrubej stavby, striech a iných konštrukčných riešení." />
    <meta name="generator" content="Astro" />
    <meta name="msvalidate.01" content="7504EE7B8C1B641BA886A62D6F85B168" />

    <!-- Open Graph: -->
    <meta property="og:title" content="Aurora Construction | Stavebná firma - Hrubá stavba, Strechy" />
    <meta property="og:description" content="Stavebná firma situovaná v Bratislave ktorá ponúka rôzne stavebné riešenia" />
    <meta property="og:image" content="https://auroraconstruction.sk/Social.jpg" />
    <meta property="og:url" content="https://auroraconstruction.sk/" />
    <meta property="og:type" content="website" />

    <!-- Twitter Cards: -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Aurora Construction | Stavebná firma - Hrubá stavba, Strechy" />
    <meta name="twitter:description" content="Stavebná firma situovaná v Bratislave ktorá ponúka rôzne stavebné riešenia" />
    <meta name="twitter:image" content="https://auroraconstruction.sk/Social.jpg" />
  
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" sizes="180x180" href="/LogoAuroraConstruction.webp">
  
    <!-- Preload Critical Resources -->
    <link rel="preload" as="image" href="/HeroSectionCropped.avif" />
    <link rel="preload" as="image" href="/favicon.svg" />
    <link rel="preload" as="image" href="/AboutImg.avif" />
  
    <!-- Preconnect for Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />

    <!-- Replace Astro import with this -->
    <link rel="preload" href="/styles/stylesheet.css" as="style">
    <link rel="stylesheet" href="/styles/stylesheet.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="/styles/stylesheet.css"></noscript>
    
    <link rel="preload" href="/styles/fonts.css" as="style">
    <link rel="stylesheet" href="/styles/fonts.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="/styles/fonts.css"></noscript> 
    
    <link rel="canonical" href="https://www.auroraconstruction.sk/" />

    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Aurora Construction",
        "description": "Stavebná firma situovaná v Bratislave ktorá ponúka stavebné riešenie hrubej stavby, stiech, alebo iných stavebných prác od odborníkov.",
        "url": "https://www.auroraconstruction.sk",
        "image": "https://www.auroraconstruction.sk/LogoBackground.png",
        "telephone": "+421 949 105 006",
        "email": "info@auroraconstruction.sk",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Nejedlého 27",
          "addressRegion": "Bratislavský kraj",
          "addressLocality": "Bratislava",
          "postalCode": "84102",
          "addressCountry": "SK"
        },
        "areaServed": {
          "@type": "Place",
          "name": "Slovensko"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+421949105006",
          "name": "Marek Harcek",
          "areaServed": "Slovensko",
          "availableLanguage": ["sk", "en"],
          "description": "Hlavné kontaktné číslo na Mareka Harceka, spoluzakladateľa Aurora Construction."
        },
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Stavebné služby",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Hrubé stavby",
                "description": "Výstavba hrubej stavby od základov profesionálne a rýchlo."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Strechy na mieru",
                "description": "Profesionálne riešenie strechy presne podľa vašich potrieb."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Ostatné práce",
                "description": "Stavebné riešenia od pokladania zámkovej dlažby cez prácu s armatúrou po sadrokartonárske práce."
              }
            }
          ]
        },
        "sameAs": [
          "https://www.instagram.com/auroraconstruction_sk",
          "https://www.facebook.com/people/Aurora-Construction/61573155748091/"
        ]
      }
    </script>

    <style>
      #main-content {
        overflow-y: auto;
        height: 100vh;
      }
    </style>
    
    <!-- Title -->
    <title>Aurora Construction | Stavebná firma - Hrubá stavba, Strechy</title>
  </head>
  

  <body>
    <div id="main-content relative">
      <div id="glow-effect" class="opacity-0 absolute top-[-5%] left-[-15%] w-[600px] h-[600px]
      bg-gradient-radial from-[#63ffd3]/30 via-[#39c4ff]/10 to-transparent
      blur-[180px] z-10 pointer-events-none "></div>

      <div class="absolute bottom-[5%] right-[-15%] w-[700px] h-[700px]
      bg-gradient-radial from-[#39c4ff]/20 via-[#63ffd3]/10 to-transparent
      blur-[200px] z-10 pointer-events-none"></div>

      <div class="absolute top-[40%] left-[-20%] w-[400px] h-[400px]
      bg-gradient-radial from-[#39c4ff]/15 via-[#63ffd3]/10 to-transparent
      blur-[150px] z-10 pointer-events-none"></div>

      <div id="glow-effect" class="opacity-0 absolute top-[30%] right-[-10%] w-[500px] h-[500px]
      bg-gradient-radial from-[#63ffd3]/25 via-[#39c4ff]/10 to-transparent
      blur-[160px] z-10 pointer-events-none hidden lg:block"></div>

      <div class="absolute bottom-[20%] left-[-12%] w-[400px] h-[400px]
      bg-gradient-radial from-[#39c4ff]/15 via-[#63ffd3]/10 to-transparent
      blur-[150px] z-10 pointer-events-none"></div>

      <Navbar />
      <Hero />
      <About />
      <Services />
      <Map title='Pôsobíme v Bratislavskom a Trnavskom kraji' description="Zameriavame sa na výstavbu a iné konštrukčné riešenia v regiónoch, ktoré dôverne poznáme. To nám umožňuje garantovať rýchlu realizáciu, jednoduchú logistiku a osobný prístup." />
      <section id="faq" class="py-24 px-6 md:px-12 bg-[#191919]">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-5xl font-bold text-center text-white mb-12">Často kladené otázky</h2>

          <div class="space-y-4">
            <!-- FAQ Item -->
            <div class="faq-item bg-[#1f1f1f] rounded-2xl shadow-md overflow-hidden">
              <button class="faq-question w-full flex justify-between items-center p-6 text-left text-white focus:outline-none">
                <span class="text-lg font-semibold">Ponúkate aj niečo iné ako výstavbu hrubej stavby alebo striech?</span>
                <svg class="faq-icon w-6 h-6 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-answer px-6 pb-6 hidden text-gray-400">
                Áno, okrem hrubej stavby a striech ponúkame aj široké spektrum stavebných prác ako sú napríklad pokládka zámkovej dlažby, murovanie priečok, sadrokartonárske práce, výstavvba plotov, debnenie alebo práca s armatúrou. Ako stavebná firma sa snažíme pokryť všetky potreby našich klientov v oblasti stavebníctva, stačí nás len bezplatne kontaktovať.
              </div>
            </div>
            <div class="faq-item bg-[#1f1f1f] rounded-2xl shadow-md overflow-hidden">
              <button class="faq-question w-full flex justify-between items-center p-6 text-left text-white focus:outline-none">
                <span class="text-lg font-semibold">Ako skoro odpovedáte po kontakte?</span>
                <svg class="faq-icon w-6 h-6 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-answer px-6 pb-6 hidden text-gray-400">
                Odpovedáme do 48 hodín, ale zvyčajne sa snažíme reagovať oveľa rýchlejšie. Ak je niečo urgentné, neváhajte to aj napísať do vašej správy a skúsime vám prioritne odpovedať.
              </div>
            </div>
            <div class="faq-item bg-[#1f1f1f] rounded-2xl shadow-md overflow-hidden">
              <button class="faq-question w-full flex justify-between items-center p-6 text-left text-white focus:outline-none">
                <span class="text-lg font-semibold">Ako začať spoluprácu alebo sa spýtať otázku?</span>
                <svg class="faq-icon w-6 h-6 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-answer px-6 pb-6 hidden text-gray-400">
                Najlepšie pre nás je, že buď vyplníte kontaktný formulár dole na našej stránke alebo napíšete na náš email <a class="text-[#7da8ba] hover:underline" href="mailto:info@auroraconstruction.sk">info@auroraconstruction.sk</a>. Ak chcete možno promptnejšiu odpoveď, môžete zavolať na naše hlavné telefónne čislo počas pracovnej doby uvedenej na Google maps, alebo napísať na Whatsapp cez link nižšie.
              </div>
            </div>
          </div>
        </div>
      </section>
      <Contact />
      <Footer />
    </div>
  </body>
  
  
</html>
  
<script>
  import gsap from 'gsap';

  window.addEventListener("load", () => {
    // Wait ~500ms to allow LCP to settle
    gsap.to("#glow-effect", {
      opacity: 1,
      duration: 3, // Further increase duration for a longer reveal
      delay: 0.5,
      ease: "power2.inOut" // Use a smoother easing function
    });
  });

  document.querySelectorAll('.faq-question').forEach(btn => {
  btn.addEventListener('click', () => {
    const item = btn.parentElement;
    if (!item) return;
    const answer = item.querySelector('.faq-answer');
    const icon = btn.querySelector('.faq-icon');
    if (answer) answer.classList.toggle('hidden');
    if (icon) icon.classList.toggle('rotate-180');
  });
});
</script>