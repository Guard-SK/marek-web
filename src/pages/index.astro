          "postalCode": "84102",
          "addressCountry": "SK"
        },
        "areaServed": {
          "@type": "Place",
          "name": "Slovensko"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+421 949 105 006",
          "name": "Marek Harcek",
          "areaServed": "Slovensko",
          "availableLanguage": ["slovenčina", "angličtina"],
