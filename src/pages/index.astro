---
import Hero from '../components/Hero.astro'
import About from '../components/About.astro'
import Services from '../components/Services.astro'
import Hruba from '../components/Hruba.astro'
import Roof from '../components/Roof.astro'
import Contact from '../components/Contact.astro'
import Footer from '../components/Footer.astro'

import '../styles/stylesheet.css'
import '../styles/fonts.css'
---

<!DOCTYPE html>
<html lang="sk">
  <head>
    <!-- Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Profesionálne stavebné riešenie hrubej stavby od odborníkov. V našej ponuke sú hrubé stavby a čoskoro aj strechy na mieru či holodom. Náš dôraz je hlavne na individuálny prístup k našim klientom a odbornom vyhotovení projektu. Hrubá stavba je naša expertíza" />
    <meta name="generator" content="Astro" />
  
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
    <!-- Preload Critical Resources -->
    <link rel="preload" as="image" href="/HolodomHero.avif" />
    <link rel="preload" as="image" href="/logo.webp" />
    <link rel="preload" as="image" href="/AboutImg.avif" />
  
    <!-- Preconnect for Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  
    <!-- Lazy-Load Fonts -->
    <link rel="preload" href="/fonts/oswald-v53-latin_latin-ext-700.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/fonts/oswald-v53-latin_latin-ext-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Aurora Construction",
        "description": "Profesionálne stavebné riešenie hrubej stavby od odborníkov. V našej ponuke sú hrubé stavby a čoskoro aj strechy na mieru či holodom. Náš dôraz je hlavne na individuálny prístup k našim klientom a odbornom vyhotovení projektu. Hrubá stavba je naša expertíza.",
        "url": "https://www.aurora-constructions.sk",
        "telephone": "+421 903 164 540",
        "email": "info@yourwebsite.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Nejedlého 27",
          "addressLocality": "Bratislava",
          "addressCountry": "SK"
        },
        "areaServed": {
          "@type": "Place",
          "name": "Slovensko"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+421 903 164 540",
          "contactType": "osobný kontakt",
          "areaServed": "Slovensko",
          "availableLanguage": ["slovenčina", "angličtina"],
          "description": "Hlavné kontaktné číslo na Mareka Harceka, spoluzakladateľa Aurora."
        },
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Stavebné služby",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Hrubé stavby",
                "description": "Vytvorenie hrubej stavby od základov profesionálne a rýchlo."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Strechy na mieru",
                "description": "Profesionálne riešenie strechy presne podľa vašich potrieb."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Holodomy",
                "description": "Moderné a kvalitné holodomy pripravené na finálnu úpravu."
              }
            }
          ]
        }
      }
    </script>

    <style>
      .scroll-container {
        overflow-y: auto;
        height: 100vh;
      }

      .snap-section {
        scroll-snap-align: start;
        min-height: 100vh;
      }

      .snap-active {
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth; /* Smooth scrolling behavior */
      }

      #intro-animation {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background: linear-gradient(180deg, #000 50%, #02072f 100%);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        overflow: hidden;
      }

      #aurora {
        position: absolute;
        width: 200%;
        height: 120%;
        background: radial-gradient(circle, rgba(0, 255, 200, 0.4) 10%, transparent 70%),
                    radial-gradient(circle, rgba(255, 0, 150, 0.3) 20%, transparent 80%),
                    radial-gradient(circle, rgba(0, 50, 255, 0.2) 15%, transparent 85%);
        background-size: 150% 150%;
        animation: aurora-move 6s infinite alternate ease-in-out;
        filter: blur(30px); /* Smooth out the edges */
        opacity: 0.9;
      }

      @keyframes aurora-move {
        0% {
          transform: translate(-20%, -15%) scale(1.2);
        }
        100% {
          transform: translate(60%, 20%) scale(1);
        }
      }

      #intro-content {
        position: relative;
        color: white;
        text-align: center;
        opacity: 0;
        animation: fade-in 1.5s 0.25s forwards;
      }

      @keyframes fade-in {
        from {
          opacity: 0;
          transform: scale(0.9);
        }
        to {
          opacity: 1;
          transform: scale(1.1);
        }
      }

      @keyframes text-scale {
        0%, 100% {
          transform: scale(0.9);
        }
        50% {
          transform: scale(1.1);
        }
      }
    </style>
    
    <!-- Title -->
    <title>Aurora Constructions | Stavebná firma</title>
  </head>
  

  <body>
    <div id="intro-animation">
      <div id="aurora"></div>
      <div id="intro-content" class="flex flex-col justify-center items-center mt-16">
        <div class="logo flex select-none justify-center gap-0 items-center text-4xl w-16 h-16 z-10 lg:h-32 lg:w-32 lg:text-7xl">
          <img src="/logo.webp" alt="Aurora constructions logo">
          <h1 class="text-[#d7d8d4]">urora</h1>
        </div>
        <h1 class="text-white gradient-text text-6xl lg:text-9xl mt-1 pb-2 mb-2 font-extrabold !leading-[1.13] select-none"><span class="gradient-text-1">VAŠA STAVBA</span><br><span class="gradient-text-2">NÁŠ ZÁVÄZOK</span></h1>
      </div>
    </div>

    <div id="main-content" class="scroll-container" style="display: none;">
        <Hero />
        <About />
        <Services />
      <div id="hruba-stavba" class="snap-section">
        <Hruba />
      </div>
      <div id="roof-section" class="snap-section">
        <Roof />
      </div>
      <div id="contact-section" class="snap-section">
        <Contact />
      </div>
        <Footer />
    </div>
  </body>
  
  
</html>
  
<script>
document.addEventListener('DOMContentLoaded', () => {
  const scrollElements = document.querySelectorAll('.scroll-reveal');

  // Intersection Observer to handle scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const target = entry.target as HTMLElement;

        if (entry.isIntersecting && !target.classList.contains('visible')) {
          // Add the 'visible' class only if it hasn't been added already
          target.classList.add('visible');
        }
      });
    },
    {
      threshold: 0.3, // Trigger when 30% of the element is visible
    }
  );

  // Observe each element with the 'scroll-reveal' class
  scrollElements.forEach((el) => observer.observe(el));
});


document.addEventListener('DOMContentLoaded', () => {
  const scrollContainer = document.querySelector('.scroll-container') as HTMLElement | null;
  const sectionsToSnap: HTMLElement[] = [
    document.getElementById('hruba-stavba'),
    document.getElementById('roof-section'),
    document.getElementById('contact-section')
  ].filter((section): section is HTMLElement => section !== null); // Filter out null values

  if (!scrollContainer || sectionsToSnap.length === 0) {
    console.error('Scroll container or sections to snap not found.');
    return;
  }

  const scrollToSection = (element: HTMLElement, duration: number) => {
    const start = scrollContainer.scrollTop;
    const end = element.offsetTop;
    const distance = end - start;
    const startTime = performance.now();

    const smoothStep = (start: number, end: number, point: number) => {
      if (point <= 0) return start;
      if (point >= 1) return end;
      return start + (end - start) * point * (2 - point); // Ease-in-out effect
    };

    const animateScroll = (currentTime: number) => {
      const timeElapsed = currentTime - startTime;
      const progress = Math.min(timeElapsed / duration, 1); // Cap progress at 1
      scrollContainer.scrollTop = smoothStep(start, end, progress);

      if (timeElapsed < duration) {
        requestAnimationFrame(animateScroll);
      }
    };

    requestAnimationFrame(animateScroll);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          scrollToSection(entry.target as HTMLElement, 0); // Adjust duration for smoothness
        }
      });
    },
    {
      threshold: 0.10 // Trigger when 15% of the section is visible
    }
  );

  sectionsToSnap.forEach((section) => {
    observer.observe(section);
  });
});

window.addEventListener("load", () => {
  const introAnimation = document.getElementById("intro-animation");
  const mainContent = document.getElementById("main-content");

  if (introAnimation && mainContent) {
  // Wait for the animation to complete
    setTimeout(() => {
      introAnimation.style.transition = "opacity 1s";
      introAnimation.style.opacity = "0";

      // After the fade-out transition, hide the intro and show main content
      setTimeout(() => {
        introAnimation.style.display = "none";
        mainContent.style.display = "block";
      }, 500); // Match the fade-out duration
    }, 1750); // Total duration of aurora animation
  }
});
</script>