---
import Navbar from "../components/Global/Navbar.astro";
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/styles/global.css" rel="stylesheet">
  <link rel="preload" href="/styles/stylesheet.css" as="style">
  <link rel="stylesheet" href="/styles/stylesheet.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/styles/stylesheet.css"></noscript>
  
  <link rel="preload" href="/styles/fonts.css" as="style">
  <link rel="stylesheet" href="/styles/fonts.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/styles/fonts.css"></noscript>
  
  <link rel="preload" href="/styles/animations.css" as="style">
  <link rel="stylesheet" href="/styles/animations.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/styles/animations.css"></noscript>    
</head>


<Navbar />
<h1 id="title" class="text-5xl font-bold mt-20 text-center">Aurora Construction</h1>
<h2 id="subtitle" class="text-2xl mt-4 text-center">Building Your Dreams</h2>
<div class="flex justify-center mt-8">
  <button id="button" class="bg-blue-500 text-white px-6 py-2 rounded">
    Contact Us
  </button>
</div>
<div class="flex flex-col items-center mt-8">
  <p class="item">Item 1</p>
  <p class="item">Item 2</p>
  <p class="item">Item 3</p>
</div>
<div class="pb-[1000px]"></div>
   
<script>
  import { gsap } from "gsap";

  const tl = gsap.timeline();
  tl.from("#title", { duration: 1, y: -50, opacity: 0 })
    .from("#subtitle", { duration: 1, y: -50, opacity: 0 }, "-=0.5")
    .from("#button", { duration: 1, y: -50, opacity: 0 }, "-=0.5")
    .from(".item", { duration: 1, y: -50, opacity: 0, stagger: 0.2 }, "-=0.5")
    .from("#button", { duration: 1, rotate: 360}, "-=0.5");
    
</script>
