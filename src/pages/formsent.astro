---
import BaseLayout from "../layouts/BaseLayout.astro";
import '../../public/styles/stylesheet.css'
---

<head>
  <meta charset="utf-8" />
</head>
<BaseLayout title="Formulár odoslaný">
  <article class="flex items-center justify-center h-screen">
    <div class="bg-[#242424] rounded-lg shadow-lg p-8 text-center w-11/12 max-w-md">
      <img src="LogoAuroraConstruction.webp" alt="Logo" class="w-24 h-auto mx-auto mb-4" />
      <h1 class="text-2xl font-bold mb-4">Ďakujeme za zaslanie formulára!</h1>
      <p class="text-lg text-gray-400 mb-6">
        Odpíšeme vám na váš email do 2 pracovných dní.
      </p>
      <a
        href="/"
        class="inline-block bg-primary text-gray-900 font-semibold py-2 px-4 rounded-md hover:bg-primary transition"
      >
        Späť na hlavnú stránku
      </a>
    </div>
  </article>
</BaseLayout>
