---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<html lang="sk">
  <head>
    <meta charset="utf-8" />
  </head>
  <BaseLayout>
    <article class="flex items-center justify-center h-screen">
      <div class="bg-[#242424] rounded-lg shadow-lg p-8 text-center w-11/12 max-w-md">
        <img src="logo.png" alt="Logo" class="w-24 h-auto mx-auto mb-4" />
        <h1 class="text-2xl font-bold mb-4">404 Stránka nebola nájdená</h1>
        <p class="text-md text-gray-400 mb-6">
          Dostali ste sa do zákutí stránky ktoré zjavne neexistujú, choďťe naspäť kliknutím na tlačidlo nižšie
        </p>
        <a
          href="/"
          class="inline-block bg-primary text-gray-900 font-semibold py-2 px-4 rounded-md hover:bg-yellow-500 transition"
        >
          Späť na hlavnú stránku
        </a>
      </div>
    </article>
  </BaseLayout>
</html>
