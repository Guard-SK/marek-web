---
import ToggleCard from './components/ToggleCard.astro';

const cards = [
  {
    image: '/icons/other-ic1.svg',
    title: 'Spoľahlivosť a precíznosť',
    description: 'Každý krov a krytina sú inštalované s maximálnou starostlivosťou.',
  },
  {
    image: '/icons/other-ic2.svg',
    title: 'Odborné poradenstvo',
    description: 'Pomôžeme vám vybrať najlepšie riešenie podľa vášho rozpočtu a potrieb.',
  },
  {
    image: '/icons/hrube-ic1.svg',
    title: 'Dlhodobá ochrana',
    description: 'Používame iba osvedčené a certifikované materiály pre čo najlepšiu životnosť vašej strechy.',
  },
];
---
  <html lang="sk">
    <head>
      <style>
        body {
          margin: 0;
          padding: 0;
          font-family: Arial, sans-serif;
          color: white;
        }
      
        /* Background image with smooth blur effect on the bottom 5% */
        .background-container {
          position: relative;
          background: url('/RoofCard.avif') no-repeat center center;
          background-size: cover;
          min-height: 100vh;
          display: flex;
          justify-content: center;
          align-items: center;
          overflow: hidden;
        }
      
        /* Overlay with smooth blur gradient */
        .background-overlay {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: linear-gradient(
            to bottom,
            rgba(25, 25, 25, 1) 0%,    /* Fully blurred at the top */
            rgba(25, 25, 25, 1) 5%,    /* Slight blur transition */
            rgba(25, 25, 25, 0.5) 15%, /* Slight blur transition */
            rgba(25, 25, 25, 0) 20%,   /* Fully transparent */
            rgba(25, 25, 25, 0) 80%,   /* Fully transparent at the middle */
            rgba(25, 25, 25, 0.5) 85%, /* Slight blur transition */
            rgba(25, 25, 25, 1) 95%,   /* Slight blur transition */
            rgba(25, 25, 25, 1) 100%   /* Fully blurred at the bottom */
          );
          z-index: 1;
        }
      
        /* Content styling */
        .content {
          position: relative;
          z-index: 2;
          max-width: 1200px;
        }
      
        .hover-card:hover {
          transform: scale(1.05);
          box-shadow: 0 5px 10px rgba(0, 0, 0, 0.3);
        }
      </style>
      
    </head>
    <body class=" ">
      <div class="background-container snap-start scroll-reveal fade-in bg-gradient-to-b from-transparent to-black" id="strechy">
        <div class="background-overlay"></div>
        <div class="content">
          <article class="container p-0 mx-auto mt-0 lg:mt-12 text-white flex flex-col lg:flex-row gap-8">
            <!-- Textová a kartová sekcia -->
            <section class="w-full overflow-hidden lg:pt-6 pt-[112px] lg:pb-6 pb-[112px] px-6">
              <div class=" bg-[rgb(25,25,25,0.7)] rounded-lg p-6">
                <div class="pb-3 pt-0 scroll-reveal fade-in">
                  <h2 class="text-4xl mt-0 md:text-5xl font-bold gradient-text-2 !leading-[1.3]">
                    <strong>Strechy</strong>
                  </h2>
                </div>
                
                <p class="text-white text-sm lg:text-base leading-relaxed scroll-reveal fade-in">
                  Strecha je jedným z najdôležitejších prvkov vášho domu – zabezpečuje ochranu pred poveternostnými podmienkami a zároveň dotvára celkový vzhľad stavby.
                  V Aurora Construction ponúkame kompletné riešenia pre strešné systémy, pričom sa špecializujeme na <span class="text-accent">sedlové a valbové strechy</span> vrátane profesionálnej montáže krovu.
                </p>
              </div>

              <section class="bg-[rgb(13,32,38,0.7)] shadow-lg md:p-8 p-6 rounded-lg flex flex-col items-center text-left mt-6">
                <div class="container mx-auto px-4">
                  <h3 class="text-4xl font-bold mb-3 text-center gradient-text-1">Naša ponuka zahŕňa</h3>
                  
                  <ul class="text-lg space-y-2 max-w-4xl mx-auto pl-0">
                    <li class="flex items-left space-x-3">
                      <span class="text-white text-xl md:text-2xl">⠕</span>
                      <span class="ml-0 text-xl md:text-2xl"><strong>Montáž strešných krovov</strong> – Precízna realizácia drevených krovov s dôrazom na stabilitu a dlhú životnosť.</span>
                    </li>
                    <li class="flex items-left space-x-3">
                      <span class="text-white text-xl md:text-2xl">⠕</span>
                      <span class="ml-0 text-xl md:text-2xl"><strong>Sedlové a valbové strechy</strong> – Klasické a estetické riešenia vhodné pre rôzne typy budov.</span>
                    </li>
                    <li class="flex items-left space-x-3">
                      <span class="text-white text-xl md:text-2xl">⠕</span>
                      <span class="ml-0  text-xl md:text-2xl"><strong>Pokládka strešných krytín</strong> – Pracujeme s kvalitnými materiálmi ako plechová a keramická krytina pre optimálnu ochranu a dlhodobú odolnosť.</span>
                    </li>
                    <li class="flex items-left space-x-3">
                      <span class="text-xl md:text-2xl text-white">⠒</span>
                      <span class="ml-0 text-xl md:text-2xl">Pultové strechy nevykonávame – špecializujeme sa na tradičné riešenia s vyššou stabilitou a estetikou.</span>
                    </li>
                  </ul>
                </div>
              </section>

              <!-- Karty -->
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
                {cards.map((card) => (
                  <ToggleCard
                    image={card.image}
                    title={card.title}
                    description={card.description}
                  />
                ))}
              </div>
              </div>
            </section>
          </article>
        </div>
      </div>
    </body>
  </html>
