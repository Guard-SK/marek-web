---
---
<body>
  <div class="max-w-7xl mx-auto py-6 px-14 scroll-reveal fade-in" id="dalsie-prace">
    <!-- Nadpis -->
    <div class="text-center my-4">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text-2 !leading-[1.2]">Ďalšie práce</h2>
      <p class="lg:text-base text-lg">Okrem hrubých stavieb a striech taktiež ponúkame</p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-6">
      <!-- Ľavý stĺpec (2 stĺpce, 3 riadky) -->
      <div class="grid grid-cols-2 gap-6">
        <div class="bg-cover bg-center h-48 rounded-lg shadow-md" style="background-image: url('/Other1.avif')">
          <div class="bg-black bg-opacity-50 h-full flex flex-col items-center justify-center rounded-lg">
            <p class="text-white text-lg lg:text-xl font-semibold text-center">Zámková dlažba</p>
            <p class="text-secondary_text text-sm lg:text-base">Pokládka a opravy</p>
          </div>
        </div>
        <div class="bg-cover bg-center h-48 rounded-lg shadow-md" style="background-image: url('/Other2.avif')">
          <div class="bg-black bg-opacity-50 h-full flex flex-col items-center justify-center rounded-lg">
            <p class="text-white text-lg lg:text-xl font-semibold text-center">Ploty</p>
            <p class="text-secondary_text text-sm lg:text-base">Výstavba a údržba</p>
          </div>
        </div>
        <div class="bg-cover bg-center h-48 rounded-lg shadow-md" style="background-image: url('/Other3.avif')">
          <div class="bg-black bg-opacity-50 h-full flex flex-col items-center justify-center rounded-lg">
            <p class="text-white text-lg lg:text-xl font-semibold text-center">Múry</p>
            <p class="text-secondary_text text-sm lg:text-base">Dekoratívne a nosné</p>
          </div>
        </div>
        <div class="bg-cover bg-center h-48 rounded-lg shadow-md" style="background-image: url('/Other4.avif')">
          <div class="bg-black bg-opacity-50 h-full flex flex-col items-center justify-center rounded-lg">
            <p class="text-white text-lg lg:text-xl font-semibold text-center">Debnenie</p>
            <p class="text-secondary_text text-sm lg:text-base">Príprava na betonáž</p>
          </div>
        </div>
        <div class="bg-cover bg-center h-48 rounded-lg shadow-md" style="background-image: url('/Other5.avif')">
          <div class="bg-black bg-opacity-50 h-full flex flex-col items-center justify-center rounded-lg">
            <p class="text-white text-lg lg:text-xl font-semibold text-center">Práca s armatúrou</p>
            <p class="text-secondary_text text-sm lg:text-base">Výstuž betónu</p>
          </div>
        </div>
        <div class="bg-cover bg-center h-48 rounded-lg shadow-md" style="background-image: url('/Other6.avif')">
          <div class="bg-black bg-opacity-50 h-full flex flex-col items-center justify-center rounded-lg">
            <p class="text-white text-lg lg:text-xl font-semibold text-center">Základové dosky</p>
            <p class="text-secondary_text text-sm lg:text-base">Základy budov</p>
          </div>
        </div>
      </div>

      <!-- Pravý stĺpec (väčšia karta) -->
      <div class="bg-[#121212] h-full rounded-lg shadow-md flex flex-col items-center justify-center p-4">
        <p class="text-white text-lg lg:text-xl font-semibold text-center">Doplnkové práce na dohodu</p>
        <p class="text-secondary_text text-sm lg:text-base text-center">
          Murovanie priečok, sadrokartonárske práce, altánky (drevenné)
        </p>
      </div>
    </div>
    <p class="text-center mt-4">Pre bližšie informácie o každej z týchto prác nás neváhajte kontaktovať!</p>
  </div>
</body>
