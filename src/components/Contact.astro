<section class="py-16 bg-[#1E1E1E]">
  <div class="container mx-auto px-6">
    <!-- Section Heading -->
    <div class="text-center mb-12">
      <h3 class="text-lg md:text-xl lg:text-2xl font-bold text-[#FFC107] mb-2">
        Kontaktujte nás
      </h3>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-[#E0E0E0] mb-4">
        MÁTE OTÁZKY ALEBO ZÁUJEM O NAŠE SLUŽBY?
      </h2>
      <p class="text-[#B0B0B0]">
        Spojte sa s nami a získajte všetky potrebné informácie!
      </p>
    </div>

    <!-- Content Grid -->
    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Contact Info -->
      <div class="lg:w-1/2 bg-[#242424] shadow-2xl rounded-lg p-8 text-[#E0E0E0]">
        <h3 class="text-xl font-bold mb-4">Kontaktné Informácie</h3>
        <p class="mb-4 text-[#B0B0B0]">
          Ak máte otázky, neváhajte nás kontaktovať na nižšie uvedené kontaktné údaje. Ak nechcete využiť formulár, kľudne využite náš email alebo napíšte na WhatsApp.
        </p>
        <ul class="space-y-4">
          <li>
            <strong>Adresa:</strong>
            <p>27 Nejedlého, Bratislava, Slovensko</p>
            <div class="mt-4">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2661.123456789!2d17.0123456789!3d48.123456789!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x476c8abcdef12345%3A0x123456789abcdef!2sNejedlého%2027%2C%20Bratislava!5e0!3m2!1ssk!2ssk!4v1697818513223!5m2!1ssk!2ssk"
                width="100%"
                height="200"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </li>
          <li>
            <strong>Telefón:</strong>
            <p>+421 123 456 789</p>
          </li>
          <li>
            <strong>Email:</strong>
            <p>
              <a
                href="mailto:info@vasafirma.sk?subject=Záujem%20o%20služby&body=Dobrý%20deň,"
                class="text-[#FFC107] underline hover:text-[#FFB300]"
              >
                info@vasafirma.sk
              </a>
            </p>
          </li>
          <li>
            <strong>Pracovné Hodiny:</strong>
            <p>Pon-Pia: 9:00 - 17:00</p>
          </li>
        </ul>
        <!-- WhatsApp Button -->
        <div class="mt-6">
          <a
            href="https://wa.me/421123456789?text=Dobrý%20deň,%20mám%20záujem%20o%20viac%20informácií%20o%20vašich%20službách."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-[#25D366] text-white font-medium py-3 px-6 rounded-lg hover:bg-[#1EBE5A] transition duration-300"
          >
            Napísať na WhatsApp
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:w-1/2">
        <form class="bg-[#242424] shadow-2xl rounded-lg p-8">
          <div class="mb-6">
            <label for="name" class="block text-sm font-medium text-[#B0B0B0] mb-2">Meno</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Vaše meno"
              class="w-full border border-gray-600 bg-[#1E1E1E] rounded-lg p-3 text-[#E0E0E0] focus:outline-none focus:ring-2 focus:ring-[#FFC107] focus:border-[#FFC107]"
            />
          </div>
          <div class="mb-6">
            <label for="email" class="block text-sm font-medium text-[#B0B0B0] mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="Vaša emailová adresa"
              class="w-full border border-gray-600 bg-[#1E1E1E] rounded-lg p-3 text-[#E0E0E0] focus:outline-none focus:ring-2 focus:ring-[#FFC107] focus:border-[#FFC107]"
            />
          </div>
          <div class="mb-6">
            <label for="message" class="block text-sm font-medium text-[#B0B0B0] mb-2">Správa</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Vaša správa"
              class="w-full border border-gray-600 bg-[#1E1E1E] rounded-lg p-3 text-[#E0E0E0] focus:outline-none focus:ring-2 focus:ring-[#FFC107] focus:border-[#FFC107]"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-[#FFC107] text-gray-900 font-medium py-3 rounded-lg hover:bg-[#FFB300] transition duration-300"
          >
            Odoslať
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
