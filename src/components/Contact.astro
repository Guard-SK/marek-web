<section class="py-0 lg:py-16 lg:pt-0 pt-16 bg-[#1E1E1E]">
  <div class="lg:container overflow-hidden mx-auto px-0 lg:px-6">
    <!-- Section Heading -->
    <div class="text-center mb-12 scroll-reveal fade-in">
      <h3 class="text-xl md:text-2xl lg:text-3xl font-bold text-[#FFC107] mb-2">
        Kontaktujte nás
      </h3>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-[#E0E0E0] mb-4">
        MÁTE OTÁZKY ALEBO ZÁUJEM O NAŠE SLUŽBY?
      </h2>
      <p class="text-[#B0B0B0]">
        Spojte sa s nami cez email, Whatsapp alebo formulár a získajte viac informácií!
      </p>
    </div>

    <!-- Content Grid -->
    <div class="flex flex-col lg:flex-row gap-12 overflow-hidden">
      <!-- Contact Form -->
      <div class="flex-1 flex-grow lg:w-1/2 lg:px-0 px-6 scroll-reveal slide-in-left">
        <form
          action="https://formsubmit.co/david.zliechovec@gmail.com"
          method="POST"
          class="bg-[#242424] shadow-2xl rounded-lg p-8 h-full"
        >
          <h3 class="text-xl font-bold mb-4">Kontaktný formulár</h3>
          <!-- Hidden Fields for FormSubmit Configuration -->
          <input type="hidden" name="_cc" value="david.zliechovec@gmail.com" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_subject" value="Nová správa z kontaktného formulára" />
          <input type="hidden" name="_autoresponse" value="Ďakujeme, že ste nás kontaktovali! Vaša správa bola úspešne prijatá a náš tím sa vám ozve do dvoch pracovných dní. <br><br> Prosím, neodpovedajte na tento email. Ak máte ďalšie otázky, neváhajte nás kontaktovať na emailovej adrese david.zliechovec@gmail.com alebo na telefónnom čísle +421 903 164 540." />
          
          <!-- Form Fields -->
          <div class="mb-4">
            <label for="name" class="block text-sm font-medium text-[#B0B0B0] mb-2">Meno</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Vaše meno"
              class="w-full border border-gray-600 bg-[#1E1E1E] rounded-lg p-3 text-[#E0E0E0] focus:outline-none focus:ring-2 focus:ring-[#FFC107] focus:border-[#FFC107]"
              required
            />
          </div>
          <div class="mb-4">
            <label for="email" class="block text-sm font-medium text-[#B0B0B0] mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="Vaša emailová adresa"
              class="w-full border border-gray-600 bg-[#1E1E1E] rounded-lg p-3 text-[#E0E0E0] focus:outline-none focus:ring-2 focus:ring-[#FFC107] focus:border-[#FFC107]"
              required
            />
          </div>
          <div class="mb-4">
            <label for="message" class="block text-sm font-medium text-[#B0B0B0] mb-2">Správa</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Vaša správa"
              class="w-full border border-gray-600 bg-[#1E1E1E] rounded-lg p-3 text-[#E0E0E0] focus:outline-none focus:ring-2 focus:ring-[#FFC107] focus:border-[#FFC107]"
              required
            ></textarea>
          </div>
          <!-- Consent Checkbox -->
          <div class="mb-4">
            <label class="flex items-start text-[#B0B0B0] text-sm">
              <input
                type="checkbox"
                name="consent"
                value="agree"
                class="mr-2 mt-1 focus:ring-2 focus:ring-[#FFC107]"
                required
              />
              <span>
                Súhlasím so spracovaním mojich osobných údajov v súlade s
                <a
                  href="/gdpr"
                  target="_blank"
                  class="text-[#FFC107] underline hover:text-[#FFB300]"
                >
                  pravidlami ochrany osobných údajov
                </a>.
              </span>
            </label>
          </div>          
          <button
            type="submit"
            class="w-full bg-[#FFC107] text-gray-900 font-medium py-3 rounded-lg hover:bg-[#FFB300] transition duration-300"
          >
            Odoslať
          </button>
        </form>
      </div>

      <!-- Contact Info -->
      <div class="flex-1 flex-grow lg:w-1/2 bg-[#242424] shadow-2xl rounded-lg p-8 text-[#E0E0E0] scroll-reveal slide-in-right">
        <h3 class="text-xl font-bold mb-4">Kontaktné Informácie</h3>
        <p class="mb-4 text-[#B0B0B0]">
          Ak máte otázky, neváhajte nás kontaktovať na nižšie uvedené kontaktné údaje. Ak nechcete využiť formulár, kľudne využite náš email alebo napíšte na WhatsApp.
        </p>
        <ul class="space-y-4">
          <li>
            <strong>Telefón:</strong>
            <p>+421 123 456 789</p>
          </li>
          <div class="mt-6">
            <a
              href="https://wa.me/421123456789?text=Dobrý%20deň,%20mám%20záujem%20o%20viac%20informácií%20o%20vašich%20službách."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-[#25D366] text-white font-medium py-3 px-6 rounded-lg hover:bg-[#1EBE5A] transition duration-300"
            >
              Napísať na WhatsApp
            </a>
          </div>
          <li>
            <strong>Email:</strong>
            <p>
              <a
                href="mailto:marek.atletika@gmail.com?subject=Záujem%20o%20služby&body=Dobrý%20deň,"
                class="text-[#FFC107] underline hover:text-[#FFB300]"
              >
                marek.atletika@gmail.com
              </a>
            </p>
          </li>
          <li>
            <strong>Adresa:</strong>
            <p>27 Nejedlého, Bratislava, Slovensko</p>
            <div class="mt-4">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2661.123456789!2d17.0123456789!3d48.123456789!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x476c8abcdef12345%3A0x123456789abcdef!2sNejedlého%2027%2C%20Bratislava!5e0!3m2!1ssk!2ssk!4v1697818513223!5m2!1ssk!2ssk"
                width="100%"
                height="200"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
