<body>
  <section class="py-0 lg:py-16 pt-16">
    <div class="lg:container overflow-hidden mx-auto px-0 lg:px-6">
      <!-- Section Heading -->
      <div class="text-center mb-8 scroll-reveal flex flex-col items-center fade-in">
        <h2 class="text-xl md:text-2xl lg:text-3xl font-bold text-primary mb-2">
          Kontaktujte nás
        </h2>
        <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold text-[#E0E0E0] mb-4">
          MÁTE OTÁZKY ALEBO ZÁUJEM O NAŠE SLUŽBY?
        </h3>
        <p class="text-[#B0B0B0]">
          Spojte sa s nami cez email, Whatsapp alebo formulár a získajte viac informácií!
        </p>
      </div>
  
      <!-- Content Grid -->
      <div class="flex flex-col lg:flex-row gap-12 overflow-hidden">
        <!-- Contact Form -->
        <div class="flex-1 flex-grow lg:w-1/2 lg:px-0 px-6 scroll-reveal slide-in-left">
          <form
            action="https://formsubmit.co/ab22cf4599c3c37c59f9c755d4965f16"
            method="POST"
            class="gradient-bg-1 shadow-2xl rounded-lg p-8 h-full"
          >
            <h3 class="text-2xl font-bold mb-4">Kontaktný formulár</h3>
            <!-- Hidden Fields for FormSubmit Configuration -->
            <input type="hidden" name="_cc" value="info@auroraconstruction.sk" />
            <input type="hidden" name="_next" value="https://marek-web-three.vercel.app//formsent" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_subject" value="Nová správa z kontaktného formulára" />
            <input type="hidden" name="_autoresponse" value="Ďakujeme, že ste nás kontaktovali! Vaša správa bola úspešne prijatá a náš tím sa vám ozve do dvoch pracovných dní. <br><br> Prosím, neodpovedajte na tento email. Ak máte ďalšie otázky, neváhajte nás kontaktovať na emailovej adrese info@auroraconstruction.sk alebo na telefónnom čísle +421 949 105 006." />
            
            <!-- Form Fields -->
            <div class="mb-4">
              <label for="name" class="block text-sm font-medium font- text-[#d3d3d3] mb-2">Meno</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Vaše meno"
                class="w-full border border-gray-600 bg-[#191919] rounded-lg p-3 text-[#E0E0E0] focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                required
              />
            </div>
            <div class="mb-4">
              <label for="email" class="block text-sm font-medium text-[#d3d3d3] mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="Vaša emailová adresa"
                class="w-full border border-gray-600 bg-[#1E1E1E] rounded-lg p-3 text-[#E0E0E0] focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                required
              />
            </div>
            <div class="mb-4">
              <label for="message" class="block text-sm font-medium text-[#d3d3d3] mb-2">Správa</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Vaša správa"
                class="w-full border border-gray-600 bg-[#1E1E1E] rounded-lg p-3 text-[#E0E0E0] focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                required
              ></textarea>
            </div>
            <!-- Consent Checkbox -->
            <div class="mb-4 flex gap-2 items-center justify-center">
              <div class="checkbox-wrapper">
                <input type="checkbox" id="cbtest" name="concent" value="agree" required />
                <label for="cbtest" class="check-box">
              </div>
              <label class="flex items-start text-[#d3d3d3] text-sm">
                <span>
                  Súhlasím so spracovaním mojich osobných údajov v súlade s
                  <a
                    href="/gdpr"
                    class="text-primary underline hover:text-accent"
                  >
                    pravidlami ochrany osobných údajov
                  </a>.
                </span>
              </label>
            </div>          
            <button
              type="submit"
              class="w-full bg-primary text-gray-900 font-medium py-3 rounded-lg hover:bg-accent transition duration-300"
            >
              Odoslať
            </button>
          </form>
        </div>
  
        <!-- Contact Info -->
        <div class="flex-1 flex-grow lg:w-1/2 bg-[#242424] shadow-2xl rounded-lg p-8 text-[#E0E0E0] scroll-reveal slide-in-right">
          <h3 class="text-xl font-bold mb-4">Kontaktné Informácie</h3>
          <p class="mb-4 text-[#B0B0B0]">
            Ak máte otázky, neváhajte nás kontaktovať na nižšie uvedené kontaktné údaje. Ak nechcete využiť formulár, kľudne využite náš email alebo napíšte na WhatsApp.
          </p>
          <div class="space-y-2">
            <div class="flex gap-2 items-center">
              <img src="/icons/phone.svg" alt="phone icon" class="w-5 h-5" loading="lazy">
              <p class="text-white"><span class="font-bold pr-1">Telefón:</span>+421 949 105 006</p>
            </div>
            <a
              href="mailto:info@auroraconstruction.sk?subject=Záujem%20o%20služby&body=Dobrý%20deň,"
              class="flex gap-2 items-center transition cursor-pointer text-white font-medium rounded-lg"
            >
              <img src="/icons/email.svg" alt="phone icon" class="w-5 h-5" loading="lazy"/>
              <span>
                <strong>Email:</strong> <span class="text-primary hover:text-accent transition duration-300 underline">info@auroraconstruction.sk</span>
              </span>
            </a>
            <div class="md:flex block md:gap-4 gap-0">
              <a
                href="https://wa.me/421949105006?text=Dobrý%20deň,%20mám%20záujem%20o%20viac%20informácií%20o%20vašich%20službách."
                target="_blank"
                rel="noopener noreferrer"
              >
                <div
                  class=" my-3 flex gap-2 items-center px-2 py-3 border-2 w-[220px] border-primary hover:bg-primary transition cursor-pointer"
                >
                  <img src="/icons/whatsapp.svg" alt="whatsapp icon" class="w-6 h-6" />
                  <span class="text-white font-medium rounded-lg transition duration-300">
                    Napísať na WhatsApp
                  </span>
                </div>
              </a> 
              <div class="flex gap-4">
                <a
                  href="https://www.instagram.com/auroraconstruction_sk"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div
                    class=" mb-3 flex gap-2 items-center justify-center w-14 px-2 py-3 border-2 border-primary hover:bg-primary transition cursor-pointer"
                  >
                    <img src="/icons/instagram.svg" alt="aurora construction instagram icon" class="w-6 h-6" />
                  </div>
                </a> 
                <a
                  href="https://www.facebook.com/people/Aurora-Construction/61573155748091/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div
                    class=" mb-3 flex gap-2 items-center justify-center w-14 px-2 py-3 border-2 border-primary hover:bg-primary transition cursor-pointer"
                  >
                    <img src="/icons/facebook.svg" alt="aurora construction facebook icon" class="w-6 h-6" />
                  </div>
                </a> 
              </div>
            </div>
            <div class="flex gap-2 items-center">
              <img src="pin.svg" alt="pin icon" class="h-5 w-5 leading-[19px]" loading="lazy">
              <p><span class="text-white font-bold pr-1">Adresa:</span>27 Nejedlého, Bratislava, Slovensko</p>
            </div>
            <div class="mt-4">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2661.123456789!2d17.0123456789!3d48.123456789!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x476c8abcdef12345%3A0x123456789abcdef!2sNejedlého%2027%2C%20Bratislava!5e0!3m2!1ssk!2ssk!4v1697818513223!5m2!1ssk!2ssk"
                width="100%"
                height="200"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Adresa Aurora Construction"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>  
</body>
