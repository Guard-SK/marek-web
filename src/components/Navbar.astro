---
import '../styles/stylesheet.css'

const { active } = Astro.props
---

<div class="bg-black bg-opacity-50 h-[78px]">
    <nav class="flex flex-row gap-6 sm:justify-end justify-center max-w-[1280px] py-6 mx-auto px-6 text-white items-center">
        <a class={`sm:text-lg text-sm relative ${active === '/' ? 'border-b-2 border-[color:var(--accent-color)] font-semibold animate-border' : ''} hover:animate-border`} href="/">Domov</a>
        <a class={`sm:text-lg text-sm relative ${active === '/projekty' ? 'border-b-2 border-[color:var(--accent-color)] font-semibold animate-border' : ''} hover:animate-border`} href="/projekty">Projekty</a>
        <a class={`sm:text-lg text-sm relative ${active === '/kalkulacka' ? 'border-b-2 border-[color:var(--accent-color)] font-semibold animate-border' : ''} hover:animate-border`} href="/kalkulacka">Kalkulačka</a>
        <a class={`sm:text-lg text-sm whitespace-nowrap relative ${active === '/info' ? 'border-b-2 border-[color:var(--accent-color)] font-semibold animate-border' : ''} hover:animate-border`} href="/info">O Nás</a>
        <a class={`sm:text-lg text-sm relative ${active === '/kontakt' ? 'border-b-2 border-[color:var(--accent-color)] font-semibold animate-border' : ''} hover:animate-border`} href="/kontakt">Kontakt</a>
    </nav>
</div>
