---
const currentPage = Astro.url.pathname;
---

<head>
  <style>
    .nav-active::after {
      content: '';
      display: block;
      width: 100%;
      height: 2px;
      background: linear-gradient(to right, #63ffd3, #39c4ff);
      margin-top: 4px;
      transition: width 0.3s;
    }

    .nav-link {
      position: relative;
    }

    .nav-link::after {
      content: '';
      display: block;
      width: 0;
      height: 2px;
      background: linear-gradient(to right, #63ffd3, #39c4ff);
      transition: width 0.3s;
      position: absolute;
      left: 0;
      bottom: -4px;
    }

    .nav-link:hover::after,
    .nav-link.nav-active::after {
      width: 100%;
    }

    .hamburger-line {
      transition: all 0.4s ease;
    }

    .line-1.open {
      transform: translateY(6px) rotate(45deg);
    }
    .line-2.open {
      opacity: 0;
    }
    .line-3.open {
      transform: translateY(-6px) rotate(-45deg);
    }
  </style>
</head>

<body class="relative overflow-x-hidden">
  <nav id="navbar" class="w-full fixed top-0 z-50">
    <!-- DESKTOP NAVBAR -->
    <div class="hidden lg:flex h-20 px-12 items-center justify-between backdrop-blur bg-[#191919]/70 border-b border-white/10">
      <div class="flex gap-10 text-white text-base font-medium">
        <a href="/" class={`nav-link ${currentPage === '/' ? 'nav-active' : ''}`}>Domov</a>
        <a href="/hruba-stavba" class={`nav-link ${currentPage === '/hruba-stavba' ? 'nav-active' : ''}`}>Hrubá stavba</a>
      </div>

      <div class="relative z-10">
        <img src="/favicon.svg" alt="Logo" class="w-12 hover:scale-105 transition duration-300" width="48" height="48" />
        <div class="absolute inset-0 w-full h-full rounded-full blur-2xl bg-gradient-radial from-[#63ffd3]/20 to-transparent animate-pulse -z-10"></div>
      </div>

      <div class="flex gap-10 text-white text-base font-medium">
        <a href="/strechy" class={`nav-link ${currentPage === '/strechy' ? 'nav-active' : ''}`}>Strechy</a>
        <a href="/elektrika" class={`nav-link ${currentPage === '/elektrika' ? 'nav-active' : ''}`}>Elektrika</a>
      </div>
    </div>

    <!-- MOBILE NAVBAR -->
    <div class="lg:hidden bg-[#191919] shadow-md flex justify-between items-center backdrop-blur bg-[#191919]/70 border-b border-white/10 h-16 px-4">
      <div class="flex-1 flex justify-center">
        <img id="nav-logo" src="/favicon.svg" alt="Aurora Construction Logo" class="w-12 ml-[14px]" width="48" height="48" />
      </div>
      <div>
        <button id="hamburger" aria-label="Toggle menu" class="flex flex-col justify-center items-center gap-1 w-7 h-7">
          <span class="hamburger-line line-1 w-full h-0.5 bg-white"></span>
          <span class="hamburger-line line-2 w-full h-0.5 bg-white"></span>
          <span class="hamburger-line line-3 w-full h-0.5 bg-white"></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile overlay -->
  <div id="mobile-menu-overlay" class="fixed inset-0 bg-[#191919] flex flex-col items-center justify-start pt-20 space-y-8 opacity-0 pointer-events-none z-40">
    <div id="nav-links" class="flex flex-col items-center space-y-10 text-3xl text-white opacity-0">
      <a href="/" class={`nav-link ${currentPage === '/' ? 'nav-active' : ''}`}>Domov</a>
      <a href="/hruba-stavba" class={`nav-link ${currentPage === '/hruba-stavba' ? 'nav-active' : ''}`}>Hrubá stavba</a>
      <a href="/strechy" class={`nav-link ${currentPage === '/strechy' ? 'nav-active' : ''}`}>Strechy</a>
      <a href="/elektrika" class={`nav-link ${currentPage === '/elektrika' ? 'nav-active' : ''}`}>Elektrika</a>
    </div>
  </div>

  <script>
    import { gsap } from 'gsap';

    const hamburger = document.getElementById('hamburger');
    const overlay = document.getElementById('mobile-menu-overlay');
    const navLogo = document.getElementById('nav-logo');
    const navLinks = document.getElementById('nav-links');

    if (
      hamburger instanceof HTMLElement &&
      overlay instanceof HTMLElement &&
      navLogo instanceof HTMLElement &&
      navLinks instanceof HTMLElement
    ) {
      const lines = hamburger.querySelectorAll('.hamburger-line');
      let logoY = 0;
      let isMenuOpen = false;

      hamburger.addEventListener('click', () => {
        isMenuOpen = !isMenuOpen;

        lines[0].classList.toggle('open', isMenuOpen);
        lines[1].classList.toggle('open', isMenuOpen);
        lines[2].classList.toggle('open', isMenuOpen);

        if (isMenuOpen) {
          overlay.classList.remove('pointer-events-none');
          overlay.classList.add('pointer-events-auto');
          gsap.to(overlay, { opacity: 1, duration: 0.75, ease: "power2.out" });

          logoY = window.innerHeight / 2 - 48;

          gsap.to(navLogo, {
            y: logoY,
            scale: 4,
            duration: 1.5,
            ease: "power3.inOut",
            onComplete: () => {
              gsap.to(navLogo, { opacity: 0.2, duration: 1 });
              gsap.to(navLinks, { opacity: 1, y: 20, duration: 0.8, ease: "power3.out", delay: 0.5 });
            }
          });
        } else {
          gsap.to(navLinks, { opacity: 0, duration: 0.4 });

          gsap.to(navLogo, {
            opacity: 1,
            duration: 0.5,
            onStart: () => {
              gsap.to(navLogo, {
                y: 0,
                scale: 1,
                duration: 1,
                delay: 0.5,
                ease: "power3.inOut"
              });
            }
          });

          gsap.to(overlay, {
            opacity: 0,
            duration: 0.5,
            delay: 1.6,
            ease: "power2.in",
            onComplete: () => {
              overlay.classList.remove('pointer-events-auto');
              overlay.classList.add('pointer-events-none');
              gsap.set(navLogo, { clearProps: "all" });
              gsap.set(navLinks, { clearProps: "all" });
            }
          });
        }
      });
    }

  </script>
</body>