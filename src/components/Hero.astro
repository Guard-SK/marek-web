<head>
  <style>
    /* Basic styles */
    body {
      margin: 0;
      font-family: Arial, sans-serif;
    }
    h1 {
      font-family: "Oswald", serif;
      font-optical-sizing: auto;
    }
    .hero {
      position: relative;
      width: 100%;
      height: 55vh;
      overflow: hidden;
      display: flex;
    }
    .hero::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(to top, #191919, rgba(0, 0, 0, 0.555) 100%);
      pointer-events: none; /* Ensures it doesn't block interaction with content */
      z-index: 1; /* Overlay appears above the images */
    }
    .hero-image {
      position: absolute;
      width: 100%;
      height: 100%;
      background-size: cover;
      opacity: 0;
      transition: opacity 0.5s ease-in-out;
      background-position: center;
    }
    .hero-image.active {
      opacity: 1;
    }
    .hero-buttons {
      position: absolute;
      bottom: 20%;
      left: 5%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      z-index: 2; /* Ensure buttons are above the overlay */
    }
    .hero-buttons h1 {
      font-family: "Roboto Condensed", serif;
    }
    .hero-button {
      width: 160px;
      height: 80px;
      background-color: #1e1e1e;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transition: all 0.3s ease;
      color: rgba(0, 0, 0, 0.8);
    }
    .hero-button:hover,
    .hero-button.active {
      background-color: #0d2026;
      color: black;
      transform: scale(1.1);
    }
    .hero-button2.active {
      transform: scale(1);
    }
    .shadow-text {
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    }
    .text-white {
      color: white;
    }
    .text-5xl {
      font-size: 6rem;
    }
    .font-bold {
      font-weight: bold;
    }

    @media (max-width: 768px) {
      .hero {
        height: 50vh;
      }
      .hero-buttons {
        bottom: 25%;
        left: 10%;
        gap: 12px;
      }
      .hero-button {
        width: 140px;
        height: 60px;
        border-radius: 12px;
      }
      .hero-button s2 {
        font-size: 14px;
        font-weight: 600;
      }
      .text-5xl {
        font-size: 4.5rem;
      }
      .logo {
        font-size: 1.75rem;
        width: 3rem;
        height: 3rem;
      }
    }

    @media (max-width: 575px) {
      .hero {
        height: 40vh;
      }
      .hero-buttons {
        bottom: 25%;
        left: 5%;
        gap: 8px;
      }
      .hero-button {
        width: 100px;
        height: 50px;
        border-radius: 8px;
      }
      .hero-button s2 {
        font-size: 13px;
        font-weight: 600;
      }
      .text-5xl {
        font-size: 3.5rem;
      }
      .logo {
        font-size: 1.5rem;
        width: 2.5rem;
        height: 2.5rem;
        right: 7%;
      }
    }
  </style>
</head>
<body>
  <div class="hero scroll-reveal fade-in">
    <div class="logo flex justify-center gap-0 items-center text-4xl absolute right-[5%] w-16 h-16 z-10 top-[5%]">
      <img src="/logo.webp" alt="Aurora construction logo">
      <h1>urora</h1>
    </div>
    <div class="hero-images">
      <div class="hero-image" style="background-image: url('/HrubeStavbyHero.avif');"></div>
      <div class="hero-image" style="background-image: url('/RoofHero.avif');"></div>
      <div class="hero-image" style="background-image: url('/HolodomHero.avif');"></div>
    </div>
    <div class="hero-buttons">
      <h1 class="text-white gradient-text text-5xl pb-2 mb-2 font-extrabold"><span class="gradient-text-1 upp">Stavby žiariace</span><br><span class="gradient-text-2">eleganciou</span></h1>
      <div class="flex-row flex gap-6">
        <div class="hero-button" data-index="0">
          <s2 class="font-semibold text-xl gradient-button-1">Hrubá stavba</s2>
        </div>
        <div class="hero-button" data-index="1">
          <s2 class="font-semibold gradient-button-2 text-xl">Strechy</s2>
        </div>
        <div class="hero-button" data-index="2">
          <s2 class="font-semibold gradient-button-3 text-xl">Ďalšie práce</s2>
        </div>
      </div>
    </div>
  </div>
  <script>
    const heroImages = document.querySelectorAll('.hero-image');
    const buttons = document.querySelectorAll('.hero-button');

    let currentIndex: number = 0; // Explicitly specify the type as number
    let interval: number | undefined; // Explicitly specify the type for interval

    const updateHero = (index: number) => { // Explicitly specify the parameter type
      heroImages.forEach((img, idx) => {
        img.classList.toggle('active', idx === index);
      });
      buttons.forEach((btn, idx) => {
        btn.classList.toggle('active', idx === index);
      });
    };

    const startCarousel = () => {
      // Clear any existing interval to avoid duplicates
      if (interval) clearInterval(interval);

      // Set up the interval to cycle through images every 5 seconds
      interval = setInterval(() => {
        requestAnimationFrame(() => {
          currentIndex = (currentIndex + 1) % heroImages.length;
          updateHero(currentIndex);
        });
      }, 5000);
    };

    // Initial delay of 3 seconds before starting the carousel
    const initializeCarousel = () => {
      // Update the hero to show the first image initially
      updateHero(currentIndex);

      // Wait 3 seconds, then start the carousel
      setTimeout(() => {
        startCarousel();
      }, 3000); // 3000 milliseconds = 3 seconds
    };

    // Call the initialize function to set up the carousel
    initializeCarousel();



    buttons.forEach((button) => {
      const btn = button as HTMLButtonElement; // Type assertion
      btn.addEventListener('mouseover', () => {
        clearInterval(interval); // Clear the interval
        currentIndex = parseInt(btn.dataset.index || '0', 10); // Convert index to number
        updateHero(currentIndex);
      });

      btn.addEventListener('mouseout', startCarousel); // Restart carousel
    });

    document.addEventListener('DOMContentLoaded', () => {
    const buttons = [
      { selector: '.hero-button[data-index="0"]', target: '#hruba-stavba' },
      { selector: '.hero-button[data-index="1"]', target: '#strechy' },
      { selector: '.hero-button[data-index="2"]', target: '#strechy' }
    ];

    buttons.forEach(({ selector, target }) => {
      const button = document.querySelector(selector);
      if (button) {
        button.addEventListener('click', () => {
          const targetSection = document.querySelector(target);
          if (targetSection) {
            // Dispatch custom event to notify scroll-to-snap logic
            document.dispatchEvent(new CustomEvent('buttonScrollStart'));

            targetSection.scrollIntoView({ behavior: 'smooth' });

            setTimeout(() => {
              document.dispatchEvent(new CustomEvent('buttonScrollEnd'));
            }, 1000); // Match the duration
          }
        });
      }
    });
  });

    // Initialize
    updateHero(currentIndex);
    startCarousel();

  </script>
</body>
