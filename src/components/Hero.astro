<head>
  <style>
    /* Basic styles */
    body {
      margin: 0;
      font-family: Arial, sans-serif;
    }
    h1 {
      font-family: "Oswald", serif;
      font-optical-sizing: auto;
    }
    .hero {
      position: relative;
      width: 100%;
      height: 50vh;
      overflow: hidden;
      display: flex;
    }
    .hero::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), #1E1E1E); /* Black overlay with gradient */
      pointer-events: none; /* Ensures it doesn't block interaction with content */
      z-index: 1; /* Overlay appears above the images */
    }
    .hero-image {
      position: absolute;
      width: 100%;
      height: 100%;
      background-size: cover;
      background-position: center;
      opacity: 0;
      transition: opacity 0.5s ease-in-out;
    }
    .hero-image.active {
      opacity: 1;
    }
    .hero-buttons {
      position: absolute;
      bottom: 25%;
      left: 5%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      z-index: 2; /* Ensure buttons are above the overlay */
    }
    .hero-button {
      width: 160px;
      height: 80px;
      background-color: white;
      border: none;
      border-radius: 16px;
      cursor: pointer;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transition: all 0.3s ease;
      color: rgba(0, 0, 0, 0.8);
    }
    .hero-button:hover,
    .hero-button.active {
      background-color:rgba(255, 193, 7, 1);
      color: black;
      transform: scale(1.1);
    }
    .hero-button2.active {
      transform: scale(1);
    }
    .shadow-text {
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    }
    .text-white {
      color: white;
    }
    .text-5xl {
      font-size: 4rem;
    }
    .font-bold {
      font-weight: bold;
    }

    @media (max-width: 768px) {
      .hero {
        height: 50vh;
      }
      .hero-buttons {
        bottom: 25%;
        left: 10%;
        gap: 12px;
      }
      .hero-button {
        width: 140px;
        height: 60px;
        border-radius: 12px;
      }
      .hero-button s2 {
        font-size: 14px;
        font-weight: 600;
      }
      .text-5xl {
        font-size: 3rem;
      }
    }

    @media (max-width: 575px) {
      .hero {
        height: 40vh;
      }
      .hero-buttons {
        bottom: 25%;
        left: 5%;
        gap: 8px;
      }
      .hero-button {
        width: 100px;
        height: 50px;
        border-radius: 8px;
      }
      .hero-button s2 {
        font-size: 13px;
        font-weight: 600;
      }
      .text-5xl {
        font-size: 2.5rem;
      }
    }
  </style>
</head>
<body>
  <div class="hero">
    <div class="hero-images">
      <div class="hero-image" style="background-image: url('/HrubeStavbyHero.avif');"></div>
      <div class="hero-image" style="background-image: url('/RoofHero.avif');"></div>
      <div class="hero-image" style="background-image: url('/HolodomHero.avif');"></div>
    </div>
    <div class="hero-buttons">
      <h1 class="text-white text-5xl font-bold shadow-text">PROFESIONÁLNE RIEŠENIE</h1>
      <div class="flex-row flex gap-6">
        <div class="hero-button" data-index="0">
          <s2 class="font-semibold text-xl">Hrubej stavby</s2>
        </div>
        <div class="hero-button opacity-60 " data-index="1">
          <s2 class="font-semibold md:leading-7 sm:leading-5 leading-4 text-xl text-gray-600">Strechy</s2>
          <p class=" text-gray-500 leading-none text-sm hidden md:flex">Čoskoro dostupné</p>
          <p class=" text-gray-500 leading-none text-xs md:hidden flex">Čoskoro</p>
        </div>
        <div class="hero-button opacity-60 " data-index="2">
          <s2 class="font-semibold md:leading-7 sm:leading-5 leading-4 text-xl text-gray-600">Holodom</s2>
          <p class=" text-gray-500 leading-none text-sm hidden md:flex">Čoskoro dostupné</p>
          <p class=" text-gray-500 leading-none text-xs md:hidden flex">Čoskoro</p>
        </div>
      </div>
      <h1 class="text-white text-5xl font-bold shadow-text ">OD ODBORNÍKOV</h1>
    </div>
  </div>
  <script>
    const heroImages = document.querySelectorAll('.hero-image');
    const buttons = document.querySelectorAll('.hero-button');

    let currentIndex: number = 0; // Explicitly specify the type as number
    let interval: number | undefined; // Explicitly specify the type for interval

    const updateHero = (index: number) => { // Explicitly specify the parameter type
      heroImages.forEach((img, idx) => {
        img.classList.toggle('active', idx === index);
      });
      buttons.forEach((btn, idx) => {
        btn.classList.toggle('active', idx === index);
      });
    };

    const startCarousel = () => {
      interval = setInterval(() => {
        currentIndex = (currentIndex + 1) % heroImages.length;
        updateHero(currentIndex);
      }, 5000);
    };

    buttons.forEach((button) => {
      const btn = button as HTMLButtonElement; // Type assertion
      btn.addEventListener('mouseover', () => {
        clearInterval(interval); // Clear the interval
        currentIndex = parseInt(btn.dataset.index || '0', 10); // Convert index to number
        updateHero(currentIndex);
      });

      btn.addEventListener('mouseout', startCarousel); // Restart carousel
    });

    document.addEventListener('DOMContentLoaded', () => {
      // Scroll to "Hrubej stavby"
      const hrubaStavbaButton = document.querySelector('.hero-button[data-index="0"]');
      if (hrubaStavbaButton) {
        hrubaStavbaButton.addEventListener('click', () => {
          const targetSection = document.querySelector('#hruba-stavba');
          if (targetSection) {
            targetSection.scrollIntoView({ behavior: 'smooth' });
          } else {
            console.error('Target section for "Hrubej stavby" not found.');
          }
        });
      } else {
        console.error('"Hrubej stavby" button not found.');
      }

      // Scroll to "Strechy" for both buttons
      const strechyButtons = document.querySelectorAll('.hero-button[data-index="1"], .hero-button[data-index="2"]');
      if (strechyButtons.length > 0) {
        strechyButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const targetSection = document.querySelector('#strechy');
            if (targetSection) {
              targetSection.scrollIntoView({ behavior: 'smooth' });
            } else {
              console.error('Target section for "Strechy" not found.');
            }
          });
        });
      } else {
        console.error('"Strechy" buttons not found.');
      }
    });

    // Initialize
    updateHero(currentIndex);
    startCarousel();

  </script>
</body>
