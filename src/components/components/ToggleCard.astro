---
// Card.astro
export interface CardProps {
  image: string;
  title: string;
  description: string;
}

const { image, title, description } = Astro.props;
---

<div class="bg-[#242424] hover-card shadow-lg p-8 rounded-lg flex flex-col items-center text-center transition duration-300">
  <img class="w-10 h-10 mb-4" src={image} alt={title} />
  <h4 class="text-lg md:text-xl font-semibold text-[#E0E0E0] mb-3">{title}</h4>
  <p class="text-[#d1d1d1] md:text-md text-sm leading-relaxed">{description}</p>
</div>
