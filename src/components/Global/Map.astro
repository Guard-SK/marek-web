---
// Map.astro
export interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<section id="coverage" class="relative w-full py-14 px-6 md:px-12 bg-[#191919] text-white overflow-hidden">
    <div class="max-w-6xl mx-auto relative z-10">
        <div class="text-center mb-8">
        <h2 class="text-3xl md:text-5xl font-bold mb-4" id="coverage-title">
            {title}
        </h2>
        <p class="text-gray-400 text-lg md:text-xl max-w-3xl mx-auto" id="coverage-desc">
            {description}
        </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center mb-4" id="coverage-benefits">
        <div class="p-4 bg-[#1f1f1f] rounded-xl" data-benefit>
            <p class="text-xl font-semibold text-[#63ffd3] mb-2">Lokalita</p>
            <p class="text-sm text-gray-400">Bratislava a okolie sú našou základňou, vieme tu promptne reagovať a plánovať.</p>
        </div>
        <div class="p-4 bg-[#1f1f1f] rounded-xl" data-benefit>
            <p class="text-xl font-semibold text-[#39c4ff] mb-2">Dostupnosť</p>
            <p class="text-sm text-gray-400">Bezproblémová dostupnosť na všetky staveniská v kraji šetrí váš čas aj náklady.</p>
        </div>
        <div class="p-4 bg-[#1f1f1f] rounded-xl" data-benefit>
            <p class="text-xl font-semibold text-[#63ffd3] mb-2">Znalosť terénu</p>
            <p class="text-sm text-gray-400">Poznáme miestne regulácie, stavebné normy aj spoľahlivých dodávateľov.</p>
        </div>
        <div class="p-4 bg-[#1f1f1f] rounded-xl" data-benefit>
            <p class="text-xl font-semibold text-[#39c4ff] mb-2">Efektivita</p>
            <p class="text-sm text-gray-400">Naše pôsobenie je sústredené, preto dokážeme pracovať rýchlo a kvalitne.</p>
        </div>
        </div>

        <img
          src="/map.avif"
          srcset="
            /map-364x182.avif 364w,
            /map.avif 728w
          "
          sizes="(max-width: 400px) 364px, 728px"
          alt="Mapa Bratislavského a Trnavského kraja"
          class="block w-full max-w-4xl mx-auto opacity-80 rounded-xl"
          loading="lazy"
          fetchpriority="low"
          width="364"
          height="182"
        />
    </div>
</section>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

// Animate title and description together for less layout thrash
gsap.timeline({
  scrollTrigger: {
    trigger: "#coverage-title",
    start: "top 85%",
    toggleActions: "play none none none"
  }
})
.from("#coverage-title", {
  y: 36,
  opacity: 0,
  duration: 0.5,
  ease: "power1.out"
})
.from("#coverage-desc", {
  y: 24,
  opacity: 0,
  duration: 0.5,
  ease: "power1.out"
}, "-=0.3");

// Animate benefit cards in a staggered batch for best performance
gsap.set("[data-benefit]", { opacity: 0, y: 20, willChange: "opacity, transform" });

ScrollTrigger.batch("[data-benefit]", {
  start: "top 85%",
  batchMax: 4,
  once: true,
  onEnter: batch => {
    gsap.to(batch, {
      opacity: 1,
      y: 0,
      duration: 0.5,
      ease: "power1.out",
      stagger: { each: 0.13 }
    });
  }
});
</script>