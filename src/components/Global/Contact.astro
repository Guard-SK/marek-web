---
/* Contact data (edit here) */
const PRIMARY_PHONE_DISPLAY = '+421 949 105 006';
const SECONDARY_PHONE_DISPLAY = '+421 919 221 760';
const PRIMARY_PHONE_TEL = PRIMARY_PHONE_DISPLAY.replace(/\s+/g, '');
const SECONDARY_PHONE_TEL = SECONDARY_PHONE_DISPLAY.replace(/\s+/g, '');
const WHATSAPP_NUMBER = '421949105006'; // without +
const CONTACT_EMAIL = 'info@auroraconstruction.sk';
const ADDRESS = 'Nejedlého 27, 841 02 Bratislava';
const OPENING_HOURS = 'Po–Ne 8:00–20:00';
---

<section id="kontakt" class="pt-16 lg:pt-20 pb-20 bg-[#191919] text-white relative">

  <!-- CONTACT FAB (mobile only, no GSAP, buttery smooth) -->
  <div id="contact-fab-root" class="md:hidden">
    <!-- Overlay -->
    <button id="contact-fab-overlay"
            type="button"
            aria-hidden="true"
            class="fixed inset-0 opacity-0 pointer-events-none transition-opacity duration-150 bg-black/30 backdrop-blur-[1px] z-[80]">
    </button>

    <!-- Sheet -->
    <nav id="contact-fab-sheet"
         class="fixed bottom-24 right-5 translate-y-2 scale-[0.98] opacity-0 pointer-events-none
                transition-[transform,opacity] duration-200 ease-out
                backdrop-blur-lg bg-white/12 border border-white/20 rounded-2xl shadow-2xl
                ring-1 ring-white/10 z-[85]"
         aria-label="Rýchly kontakt" aria-hidden="true">
      <ul class="p-2 w-[220px]">
        <li class="fab-item">
          <a href={`tel:${PRIMARY_PHONE_TEL}`}
             class="group flex items-center gap-3 w-full rounded-xl px-3 py-2
                    bg-white/10 hover:bg-white/15 active:bg-white/20 transition
                    focus:outline-none focus:ring-2 focus:ring-[#63ffd3]/60">
            <img src="/icons/phone.svg" alt="Zavolať" class="w-4 h-4 opacity-90 group-hover:opacity-100 transition"/>
            <span class="text-[15px]">Zavolať</span>
          </a>
        </li>
        <li class="mt-1 fab-item">
          <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=Dobrý%20deň,%20mám%20záujem%20o%20viac%20informácií.`}
             target="_blank" rel="noopener"
             class="group flex items-center gap-3 w-full rounded-xl px-3 py-2
                    bg-white/10 hover:bg-white/15 active:bg-white/20 transition
                    focus:outline-none focus:ring-2 focus:ring-[#63ffd3]/60">
            <img src="/icons/whatsapp.svg" alt="WhatsApp" class="w-4 h-4 opacity-90 group-hover:opacity-100 transition"/>
            <span class="text-[15px]">WhatsApp</span>
          </a>
        </li>
        <li class="mt-1 fab-item">
          <a href="#lead-form"
             class="group flex items-center gap-3 w-full rounded-xl px-3 py-2
                    bg-[#63ffd3] text-black hover:opacity-90 active:opacity-100 transition
                    focus:outline-none focus:ring-2 focus:ring-[#63ffd3]/60">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a1 1 0 011 1v8h8a1 1 0 110 2h-8v8a1 1 0 11-2 0v-8H3a1 1 0 110-2h8V3a1 1 0 011-1z"/>
            </svg>
            <span class="text-[15px] font-semibold">Nezáväzná ponuka</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Floating button (always on top) -->
    <button id="contact-fab"
            aria-label="Rýchly kontakt"
            aria-haspopup="menu"
            aria-controls="contact-fab-sheet"
            aria-expanded="false"
            class="fixed bottom-5 right-5 w-14 h-14 rounded-full flex items-center justify-center select-none
                   backdrop-blur-lg bg-black/10 border border-white/15 shadow-[0_10px_30px_rgba(0,0,0,0.35)]
                   ring-1 ring-white/10 text-white transition-transform duration-150 active:scale-95 z-[90]">
      <!-- Phone icon -->
      <svg id="fab-icon-phone" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 transition-opacity duration-150" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V21a1 1 0 01-1 1C10.07 22 2 13.93 2 3a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.2 2.2z"/>
      </svg>
      <!-- X icon -->
      <svg id="fab-icon-x" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 absolute opacity-0 transition-opacity duration-150" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.225 4.811 4.811 6.225 10.586 12l-5.775 5.775 1.414 1.414L12 13.414l5.775 5.775 1.414-1.414L13.414 12l5.775-5.775-1.414-1.414L12 10.586 6.225 4.811z"/>
      </svg>
    </button>
  </div>
  <!-- /FAB -->

  <div class="lg:container mx-auto px-4 lg:px-6">
    <!-- Heading -->
    <div class="text-center mb-10 flex flex-col items-center">
      <h2 class="text-xl md:text-2xl lg:text-3xl font-bold text-[#63ffd3] mb-2">Kontaktujte nás</h2>
      <h3 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-white mb-3 tracking-tight">Máte otázky alebo záujem o naše služby?</h3>
      <p class="text-[#B0B0B0] max-w-2xl">Spojte sa s nami cez telefón, WhatsApp alebo formulár a získajte rýchlu orientačnú ponuku. Odpovieme do 48 h.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <!-- CONTACT INFO / QUICK ACTIONS -->
      <aside class="bg-neutral-900/40 rounded-2xl border border-neutral-800 p-6 lg:p-8 order-2 lg:order-1">
        <h3 class="text-2xl font-semibold mb-1">Sme k dispozícii</h3>
        <p class="text-sm opacity-80 mb-4">{OPENING_HOURS}</p>

        <!-- Primary actions -->
        <div class="grid sm:grid-cols-2 gap-3 mb-6">
          <a href={`tel:${PRIMARY_PHONE_TEL}`} class="inline-flex items-center justify-center gap-2 border border-[#63ffd3] text-white font-semibold py-3 px-4 rounded-xl hover:opacity-90">
            <img src="/icons/phone.svg" class="w-5 h-5" alt="phone"/> Zavolať: {PRIMARY_PHONE_DISPLAY}
          </a>
          <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=Dobrý%20deň,%20mám%20záujem%20o%20viac%20informácií.`} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border border-[#63ffd3] text-white py-3 px-4 rounded-xl hover:bg-neutral-800">
            <img src="/icons/whatsapp.svg" class="w-5 h-5" alt="WhatsApp"/> WhatsApp
          </a>
        </div>

        <!-- Details list -->
        <ul class="space-y-3 mb-4">
          <li class="flex items-center gap-2"><img src="/icons/phone.svg" class="w-5 h-5" alt=""/> <span class="text-white"><b>Telefón:</b> {PRIMARY_PHONE_DISPLAY} <span class="opacity-70">|</span> {SECONDARY_PHONE_DISPLAY}</span></li>
          <li><a href={`mailto:${CONTACT_EMAIL}?subject=Záujem%20o%20služby&body=Dobrý%20deň,`} class="flex items-center gap-2"><img src="/icons/email.svg" class="w-5 h-5" alt=""/> <span><b>E-mail:</b> <span class="text-[#39c4ff] underline">{CONTACT_EMAIL}</span></span></a></li>
          <li class="flex items-center gap-2"><img src="/icons/pin.svg" class="w-5 h-5" alt=""/> <span><b>Adresa:</b> {ADDRESS}</span></li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path fill-rule="evenodd" d="M4.5 3.75a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V6.75a3 3 0 0 0-3-3h-15Zm4.125 3a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5Zm-3.873 8.703a4.126 4.126 0 0 1 7.746 0 .75.75 0 0 1-.351.92 7.47 7.47 0 0 1-3.522.877 7.47 7.47 0 0 1-3.522-.877.75.75 0 0 1-.351-.92ZM15 8.25a.75.75 0 0 0 0 1.5h3.75a.75.75 0 0 0 0-1.5H15ZM14.25 12a.75.75 0 0 1 .75-.75h3.75a.75.75 0 0 1 0 1.5H15a.75.75 0 0 1-.75-.75Zm.75 2.25a.75.75 0 0 0 0 1.5h3.75a.75.75 0 0 0 0-1.5H15Z" clip-rule="evenodd" /></svg>
            <span><b>IČO:</b> 56770294</span>
          </li>
        </ul>

        <!-- Map -->
        <div class="rounded-xl overflow-hidden border border-neutral-800">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2659.687758439997!2d17.033468077055687!3d48.193367271249755!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd4b63380cabc0ff%3A0xff1614f8a0ff269f!2sAurora%20Construction!5e0!3m2!1ssk!2ssk!4v1744007877348!5m2!1ssk!2ssk" 
            width="100%" height="220" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Adresa Aurora Construction">
          </iframe>
        </div>

        <p class="text-xs opacity-70 mt-4">Poznámka: Služby aktuálne poskytujeme ako súkromný živnostník. Tým šetríme čas i náklady na byrokraciu, vďaka čomu máte garantované výhodnejšie ceny. O prechode na s.r.o. uvažujeme v budúcnosti, ďakujeme za pochopenie.</p>
      </aside>

      <!-- LEAD FORM (2-step) -->
      <div class="order-1 lg:order-2">
        <form id="lead-form" class="rounded-2xl shadow-2xl p-6 lg:p-8 gradient-bg-1 border border-neutral-800" method="POST" novalidate>
          <h3 class="text-2xl font-bold mb-2">Nezáväzná cenová ponuka</h3>
          <p class="text-sm opacity-80 mb-4">Vyplnenie zaberie ~60 sekúnd. Odpovieme do 48 h.</p>

          <!-- stepper -->
          <div class="flex items-center justify-between text-xs mb-1" aria-live="polite">
            <span id="step-title">Krok 1 z 2 — Projekt</span>
            <span id="step-hint">Ďalej: Kontakt</span>
          </div>
          <div class="flex items-center gap-3 mb-3" aria-label="Priebeh krokov">
            <div id="stepbar-1" class="h-2 flex-1 rounded-full bg-[#63ffd3]"></div>
            <div id="stepbar-2" class="h-2 flex-1 rounded-full bg-neutral-700"></div>
          </div>

          <!-- STEP 1 -->
          <fieldset id="step-1" class="space-y-3" aria-labelledby="legend-projekt">
            <legend id="legend-projekt" class="sr-only">Informácie o projekte</legend>

            <div>
              <label for="service" class="block text-sm mb-1">Typ práce <span class="text-[#63ffd3]">*</span></label>
              <select id="service" name="service" required class="w-full bg-neutral-900 border border-neutral-700 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#39c4ff]">
                <option value="">Vyberte možnosť</option>
                <option>Hrubá stavba</option>
                <option>Strecha – krov/škridla/plech</option>
                <option>Rekonštrukcia</option>
                <option>Základy / platňa</option>
                <option>Prístavba</option>
                <option>Iné</option>
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="location" class="block text-sm mb-1">Lokalita <span class="text-[#63ffd3]">*</span></label>
                <input id="location" name="location" required placeholder="Bratislava / Senec / …" class="w-full bg-neutral-900 border border-neutral-700 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#39c4ff]" />
              </div>
              <div>
                <label for="area" class="block text-sm mb-1">Rozsah (m²)</label>
                <div class="flex items-center gap-3">
                  <input type="range" id="area" min="10" max="400" step="5" class="w-full accent-[#39c4ff]" />
                  <input id="area_num" name="area" type="number" inputmode="numeric" min="0" max="1000" class="w-24 bg-neutral-900 border border-neutral-700 rounded-lg p-2 text-center focus:outline-none focus:ring-2 focus:ring-[#39c4ff]" />
                </div>
                <p class="text-xs opacity-70 mt-1">Ak neviete presne, nechajte približne.</p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="timeline" class="block text-sm mb-1">Termín realizácie</label>
                <select id="timeline" name="timeline" class="w-full bg-neutral-900 border border-neutral-700 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#39c4ff]">
                  <option>Čo najskôr</option>
                  <option>1–3 mesiace</option>
                  <option>3–6 mesiacov</option>
                  <option>Nemám isté / podľa dohody</option>
                </select>
              </div>
              <div>
                <label for="budget" class="block text-sm mb-1">Rozpočet</label>
                <select id="budget" name="budget" class="w-full bg-neutral-900 border border-neutral-700 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#39c4ff]">
                  <option value="">Zatiaľ neviem</option>
                  <option>do 10 000 €</option>
                  <option>10 000 – 30 000 €</option>
                  <option>30 000 – 60 000 €</option>
                  <option>60 000 € +</option>
                </select>
              </div>
            </div>

            <div>
              <label for="description" class="block text-sm mb-1">Krátky popis</label>
              <textarea id="description" name="description" rows="4" placeholder="Napr. bungalov, Ytong, strecha sedlová, cca 140 m², pripravený projekt." class="w-full bg-neutral-900 border border-neutral-700 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#39c4ff]"></textarea>
            </div>

            <div class="flex items-center justify-between pt-1">
              <p class="text-xs opacity-70"></p>
              <button type="button" id="btn-to-step-2" class="inline-flex items-center gap-2 bg-[#63ffd3] text-black font-semibold px-5 py-3 rounded-lg hover:opacity-90">
                Pokračovať
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M13.172 12 8.222 7.05l1.414-1.414L16 12l-6.364 6.364-1.414-1.414z"/></svg>
              </button>
            </div>
          </fieldset>

          <!-- STEP 2 -->
          <fieldset id="step-2" class="space-y-3 hidden" aria-labelledby="legend-kontakt">
            <legend id="legend-kontakt" class="sr-only">Kontaktné údaje</legend>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-sm mb-1">Meno a priezvisko <span class="text-[#63ffd3]">*</span></label>
                <input id="name" name="name" required class="w-full bg-neutral-900 border border-neutral-700 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#39c4ff]" />
              </div>
              <div>
                <label for="email" class="block text-sm mb-1">E-mail <span class="text-[#63ffd3]">*</span></label>
                <input id="email" name="email" type="email" required placeholder="xyz@gmail.com" class="w-full bg-neutral-900 border border-neutral-700 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#39c4ff]" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="phone" class="block text-sm mb-1">Telefón</label>
                <input id="phone" name="phone" inputmode="tel" placeholder="+421 9XX XXX XXX" class="w-full bg-neutral-900 border border-neutral-700 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#39c4ff]" />
              </div>
              <div>
                <span class="block text-sm mb-1">Preferujem kontakt</span>
                <div class="flex flex-wrap gap-3 pt-2">
                  <label class="inline-flex items-center gap-2"><input type="radio" class="accent-[#39c4ff]" name="preferredContact" value="Telefonát" checked> <span class="text-sm">Telefonát</span></label>
                  <label class="inline-flex items-center gap-2"><input type="radio" class="accent-[#39c4ff]" name="preferredContact" value="WhatsApp"> <span class="text-sm">WhatsApp</span></label>
                  <label class="inline-flex items-center gap-2"><input type="radio" class="accent-[#39c4ff]" name="preferredContact" value="E-mail"> <span class="text-sm">E-mail</span></label>
                </div>
              </div>
            </div>

            <div>
              <label class="block text-sm mb-1">Projektová dokumentácia <span class="text-xs text-gray-400">- (nepovinné)</span></label>
              <input type="hidden" id="uc-uploader"
                     data-multiple data-multiple-max="10" data-clearable data-tabs="file camera url" data-system-dialog="true" />
              <input type="hidden" name="file_urls" id="file_urls" />
              <p class="text-xs opacity-70 mt-1">Max 10 súborov. Skúste nepridávať zbytočne veľké súbory.</p>
              <div id="uc-preview" class="mt-2 text-xs opacity-80"></div>
            </div>

            <!-- Consent + honeypot -->
            <div class="flex items-start gap-3">
              <input id="consent" type="checkbox" name="consent" required class="mt-1 accent-[#39c4ff]">
              <label for="consent" class="text-sm">Súhlasím so spracovaním osobných údajov pre účely nacenenia a kontaktovania. <a href="/gdpr" class="underline text-[#39c4ff]">Podmienky ochrany súkromia</a>.</label>
            </div>

            <input type="text" name="_honey" id="hp" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true">

            <!-- EmailJS helper fields -->
            <input type="hidden" name="reply_to" value={CONTACT_EMAIL}>
            <input type="hidden" name="_subject" value="Aurora – nový dopyt z webu">

            <div class="flex items-center justify-between">
              <button type="button" id="btn-back" class="px-5 py-3 rounded-lg border border-neutral-700 hover:bg-neutral-800">Späť</button>
              <div class="text-right">
                <button type="submit" id="btn-submit" class="inline-flex items-center gap-2 bg-[#63ffd3] text-black font-semibold px-5 py-3 rounded-lg hover:opacity-90 disabled:opacity-50">Odoslať dopyt</button>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Client script (runs in browser) -->
<script is:inline>
(function(){
  // ====== STEP LOGIC & VALIDATION ======
  const form = document.getElementById('lead-form');
  const step1 = document.getElementById('step-1');
  const step2 = document.getElementById('step-2');
  const bar1  = document.getElementById('stepbar-1');
  const bar2  = document.getElementById('stepbar-2');
  const toStep2Btn = document.getElementById('btn-to-step-2');
  const backBtn = document.getElementById('btn-back');
  const submitBtn = document.getElementById('btn-submit');
  const stepTitle = document.getElementById('step-title');
  const stepHint  = document.getElementById('step-hint');

  const dl = (evt, extra={}) => { window.dataLayer = window.dataLayer || []; window.dataLayer.push({event: evt, ...extra}); };
  const q  = (sel) => document.querySelector(sel);

  // range <-> number sync
  const area = document.getElementById('area');
  const areaNum = document.getElementById('area_num');
  if (area && areaNum){
    area.addEventListener('input', () => areaNum.value = area.value);
    areaNum.addEventListener('input', () => area.value = areaNum.value);
  }

  function setStep(n){
    const first = (n === 1);
    step1.classList.toggle('hidden', !first);
    step2.classList.toggle('hidden', first);

    bar1.classList.add('bg-[#63ffd3]');
    bar2.classList.toggle('bg-[#63ffd3]', !first);
    bar2.classList.toggle('bg-neutral-700', first);

    stepTitle.textContent = first ? 'Krok 1 z 2 — Projekt' : 'Krok 2 z 2 — Kontakt';
    stepHint.textContent  = first ? 'Ďalej: Kontakt' : 'Vyplňte a odošlite';
  }

  function validateStep1(){
    const service = q('#service');
    const location = q('#location');
    let ok = true;
    if(!service.value){ service.classList.add('ring-2','ring-red-400'); ok=false; } else { service.classList.remove('ring-2','ring-red-400'); }
    if(!location.value || location.value.trim().length < 2){ location.classList.add('ring-2','ring-red-400'); ok=false; } else { location.classList.remove('ring-2','ring-red-400'); }
    return ok;
  }

  function validateStep2(){
    // Native HTML5 constraints first
    if (!form.checkValidity()){ form.reportValidity(); return false; }

    const prefer  = q('input[name="preferredContact"]:checked')?.value;
    const phone   = q('#phone');

    // Require phone for call/WhatsApp
    if (prefer === 'Telefonát' || prefer === 'WhatsApp'){
      const okPhone = /^\+?\d[\d\s]{7,}$/.test((phone.value||'').trim());
      phone.classList.toggle('ring-2', !okPhone);
      phone.classList.toggle('ring-red-400', !okPhone);
      if (!okPhone){ phone.focus(); return false; }
    }
    return true;
  }

  function goStep2(){
    if(!validateStep1()) return;
    setStep(2);
    dl('lead_step',{step:1, service: q('#service').value});
  }
  function backStep(){ setStep(1); }

  toStep2Btn?.addEventListener('click', goStep2);
  backBtn?.addEventListener('click', backStep);

  // ====== EmailJS (client) ======
  function loadEmailJs(callback){
    if(window.emailjs){ callback(); return; }
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
    s.async = true;
    s.onload = callback;
    document.body.appendChild(s);
  }
  function ensureEmailJsInit(){
    if(!window.emailjs) return false;
    try { window.emailjs.init('RlGbH0KqxKcbUU8eo'); return true; } catch(e){ return false; }
  }

  form?.addEventListener('submit', function(e){
    e.preventDefault();
    if(q('#hp')?.value){ return; } // honeypot
    if(step2.classList.contains('hidden')){ goStep2(); return; }
    if(!validateStep2()) return;

    submitBtn.disabled = true;

    loadEmailJs(() => {
      if(!window.emailjs || !ensureEmailJsInit()) { submitBtn.disabled=false; alert('EmailJS sa nenačítal. Skúste znova alebo zavolajte.'); return; }

      window.emailjs.sendForm('service_vwf903m', 'contact_form_template', form)
        .then(async () => {
          dl('lead_submit',{ service: q('#service').value, location: q('#location').value });

          const clientTpl = 'template_b5pe7dl'.trim();
          const email = q('#email')?.value || '';
          if(clientTpl && email){
            try {
              await window.emailjs.send('service_vwf903m', clientTpl, {
                to_email: email,
                to_name: q('#name')?.value || '',
                service: q('#service')?.value || '',
                location: q('#location')?.value || '',
                timeline: q('#timeline')?.value || '',
                area: q('#area_num')?.value || ''
              });
            } catch(_) {}
          }

          form.reset();
          setStep(1);
          alert('Ďakujeme, dopyt sme prijali. Ozveme sa do 48 hodín.');
        })
        .catch((err) => {
          console.error('EmailJS error', err);
          submitBtn.disabled = false;
          alert('Ospravedlňujeme sa, odoslanie zlyhalo. Skúste znova, alebo nám zavolajte.');
        });
    });
  });

  // ====== Uploadcare (preview of URLs) ======
  (function loadUC(callback){
    if(window.uploadcare){ callback && callback(); return; }
    const s = document.createElement('script');
    s.src = 'https://ucarecdn.com/libs/widget/3.x/uploadcare.full.min.js';
    s.async = true;
    s.onload = callback;
    document.body.appendChild(s);
  })(() => {
    const ucKey = '28525508c60e5443a490'.trim();
    if(ucKey){ window.UPLOADCARE_PUBLIC_KEY = ucKey; }
    const input = document.getElementById('uc-uploader');
    if(!input || !window.uploadcare) return;
    const widget = uploadcare.Widget(input);
    const preview = document.getElementById('uc-preview');
    const hidden = document.getElementById('file_urls');

    function setUrlsFromFiles(filesPromise){
      Promise.all(filesPromise).then(list => {
        const urls = list.map(f => f.cdnUrl).filter(Boolean);
        hidden.value = urls.join(', ');
        preview.innerHTML = urls.map(u => `<a href="${u}" target="_blank" class="underline text-[#39c4ff]">${u.split('/').pop()}</a>`).join('<br>');
      });
    }
    widget.onUploadComplete(info => {
      if(info && typeof info.files === 'function') setUrlsFromFiles(info.files());
      else if(info) setUrlsFromFiles([Promise.resolve(info)]);
    });
  });

  // ====== FAB (no GSAP) ======
  (function initFAB(){
    const root    = document.getElementById('contact-fab-root');
    const btn     = document.getElementById('contact-fab');
    const overlay = document.getElementById('contact-fab-overlay');
    const sheet   = document.getElementById('contact-fab-sheet');
    if(!root || !btn || !overlay || !sheet) return;

    function isOpen(){ return root.hasAttribute('data-open'); }
    function open(){
      root.setAttribute('data-open','true');
      btn.setAttribute('aria-expanded','true');
      sheet.setAttribute('aria-hidden','false');
      const firstLink = sheet.querySelector('a,button,[tabindex]:not([tabindex="-1"])');
      setTimeout(()=> firstLink?.focus({preventScroll:true}), 120);
    }
    function close(){
      root.removeAttribute('data-open');
      btn.setAttribute('aria-expanded','false');
      sheet.setAttribute('aria-hidden','true');
      btn.focus({preventScroll:true});
    }
    function toggle(){ isOpen() ? close() : open(); }

    btn.addEventListener('click', toggle);
    overlay.addEventListener('click', close);

    // ESC + focus trap
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) { e.preventDefault(); close(); }
      if (e.key === 'Tab' && isOpen()){
        const f = sheet.querySelectorAll('a,button,[tabindex]:not([tabindex="-1"])');
        if (!f.length) return;
        const first = f[0], last = f[f.length-1];
        if (e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
      }
    });

    // Close when moving to desktop
    const mql = window.matchMedia('(min-width: 768px)');
    const onBp = () => { if (mql.matches && isOpen()) close(); };
    mql.addEventListener ? mql.addEventListener('change', onBp) : mql.addListener(onBp);
  })();
})();
</script>

<style is:global>
  /* iOS glass vibes */
  #contact-fab {
    box-shadow: 0 10px 30px rgba(0,0,0,.35), 0 2px 6px rgba(0,0,0,.35);
  }
  @media (hover:hover){
    #contact-fab:hover { transform: translateY(-2px); }
  }

  /* Optional soft gradient background class */
  .gradient-bg-1{
    background:
      radial-gradient(1200px 600px at 80% -10%, rgba(99,255,211,.30), transparent),
      radial-gradient(900px 500px at -10% 110%, rgba(57,196,255,.15), transparent),
      #1b1b1b;
  }

  /* Smooth enter/exit & stagger for menu items */
  #contact-fab-root .fab-item { 
    opacity: 0; transform: translateY(6px);
    transition: opacity .18s ease, transform .18s ease;
  }
  #contact-fab-root[data-open="true"] .fab-item { opacity: 1; transform: none; }
  #contact-fab-root[data-open="true"] .fab-item:nth-child(1) { transition-delay: .02s; }
  #contact-fab-root[data-open="true"] .fab-item:nth-child(2) { transition-delay: .06s; }
  #contact-fab-root[data-open="true"] .fab-item:nth-child(3) { transition-delay: .10s; }

  /* Sheet & overlay open states */
  #contact-fab-root[data-open="true"] #contact-fab-sheet {
    opacity: 1; transform: translateY(0) scale(1); pointer-events: auto;
  }
  #contact-fab-root[data-open="true"] #contact-fab-overlay {
    opacity: 1; pointer-events: auto;
  }

  /* Icon swap */
  #contact-fab-root[data-open="true"] #fab-icon-phone { opacity: 0; }
  #contact-fab-root[data-open="true"] #fab-icon-x     { opacity: 1; }

  /* Motion safety */
  @media (prefers-reduced-motion: reduce){
    #contact-fab-sheet, #contact-fab-overlay, #contact-fab, #contact-fab-root .fab-item { 
      transition: none !important; 
    }
  }
</style>
