<html lang="en">
  <head>
    <style>
        .card-1 {
            position: relative; /* Ensure the pseudo-element is positioned relative to the card */
            background-image: url('/HrubaStavbaCard.jpg');
            background-position: left;
            background-size: cover;
            color: white; /* Ensures text is white and visible */
            z-index: 1; /* Ensures text stays above the overlay */
            overflow: hidden; /* Prevents pseudo-element from overflowing the card */
        }

        .card-1::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5); /* Black overlay with 50% opacity */
            z-index: -1; /* Places the overlay below the text */
        }

