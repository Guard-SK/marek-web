<html lang="sk">
  <head>
    <style>
      .card {
        position: relative;
        background-position: center;
        background-size: cover;
        color: white;
        z-index: 1;
        overflow: hidden;
        transition: transform 0.3s ease; /* Smooth transition */
      }

      .card:hover {
        transform: scale(1.05); /* Resizes smoothly to 1.05 times the size */
      }

      .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: -1;
      }

      .card-1 {
        background-image: url('/HrubaStavbaCard.jpg');
      }

      .card-2 {
        background-image: url('/RoofCard.jpg');
      }

      .card-3 {
        background-image: url('/HolodomCard.jpg');
      }
    </style>
  </head>
  <body>
    <div class="container mx-auto sm:mt-24 lg:mt-18 mt-14  pb-14 px-6">
      <div class="text-center mb-8">
        <h1 class="font-bold text-5xl lg:text-4xl sm:text-5xl">
          NAŠE <span class="text-[#FFC107]">SLUŽBY</span>
        </h1>
        <h4 class="text-[#B0B0B0] text-lg lg:text-md sm:text-lg">
          stavebné riešenia, ktoré splnia všetky vaše požiadavky
        </h4>
      </div>
      <div class="flex flex-wrap gap-4 justify-center py-4">
        <!-- Card 1 -->
        <div class="card card-1 w-full sm:w-[calc(50%-8px)] lg:w-[calc(33.33%-8px)] bg-black h-[200px] p-4 rounded-lg flex align-bottom">
          <p class="h-auto mt-auto font-semibold text-xl md:text-lg sm:text-base">
            Hrubá stavba
          </p>
        </div>
        <!-- Card 2 -->
        <div class="card card-2 w-full sm:w-[calc(50%-8px)] lg:w-[calc(33.33%-8px)] bg-black h-[200px] p-4 rounded-lg flex align-bottom">
          <p class="h-auto mt-auto font-semibold text-xl md:text-lg sm:text-base">
            Strecha
          </p>
        </div>
        <!-- Card 3 -->
        <div class="card card-3 w-full sm:w-[calc(50%-8px)] lg:w-[calc(33.33%-8px)] bg-black h-[200px] p-4 rounded-lg flex align-bottom shadow-2xl">
          <p class="h-auto mt-auto font-semibold text-xl md:text-lg sm:text-base">
            Holodom
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
