<html lang="sk">
  <head>
    <style>
      .card {
        position: relative;
        background-position: center;
        background-size: cover;
        color: white;
        z-index: 1;
        overflow: hidden;
        transition: transform 0.3s ease;
      }

      .card:hover {
        transform: scale(1.05);
      }

      .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: -1;
      }

      .card-1 {
        background-image: url('/HrubaStavbaCard.avif');
      }

      .card-2 {
        background-image: url('/RoofCard.avif');
      }

      .card-3 {
        background-image: url('/HolodomCard.avif');
      }

      .icon-arrow {
        width: 32px;
        height: 32px;
        margin-left: auto;
        margin-top: auto;
        object-fit: contain;
        transition: transform 0.3s ease;
      }

      .card:hover .icon-arrow {
        transform: translateX(5px);
      }
    </style>
  </head>
  <body>
    <div class="container overflow-hidden mx-auto sm:mt-24 lg:mt-18 mt-14  pb-14 px-6">
      <div class="text-center mb-8 scroll-reveal fade-in">
        <h2 class="font-bold text-5xl lg:text-4xl sm:text-5xl">
          NAŠE <span class="text-primary">SLUŽBY</span>
        </h2>
        <p class="text-[#B0B0B0] text-lg lg:text-md sm:text-lg">
          stavebné riešenia, ktoré splnia všetky vaše požiadavky
        </p>
      </div>
      <div class="flex flex-wrap gap-4 justify-center py-4 overflow-hidden">
        <!-- Card 1 -->
        <div class="card card-1 w-full cursor-pointer sm:w-[calc(50%-8px)] lg:w-[calc(33.33%-8px)] bg-black h-[200px] p-4 rounded-lg flex justify-between align-bottom scroll-reveal slide-in-left" data-index="0">
          <p class="h-auto mt-auto font-semibold text-xl md:text-lg sm:text-base text-white">
            Hrubá stavba
          </p>
          <img src="/icons/arrow.svg" alt="Arrow Icon" class="icon-arrow">
        </div>        
        <!-- Card 2 -->
        <div class="card card-2 w-full cursor-pointer sm:w-[calc(50%-8px)] lg:w-[calc(33.33%-8px)] bg-black h-[200px] p-4 rounded-lg flex justify-between align-bottom scroll-reveal slide-in-right" data-index="1">
          <p class="h-auto mt-auto font-semibold text-xl md:text-lg sm:text-base text-white">
            Strecha
          </p>
          <img src="/icons/arrow.svg" alt="Arrow Icon" class="icon-arrow">
        </div>        
        <!-- Card 3 -->
        <div class="card card-3 w-full cursor-pointer sm:w-[calc(50%-8px)] lg:w-[calc(33.33%-8px)] bg-black h-[200px] p-4 rounded-lg flex justify-between align-bottom scroll-reveal slide-in-left" data-index="2">
          <p class="h-auto mt-auto font-semibold text-xl md:text-lg sm:text-base text-white">
            Ďalšie práce
          </p>
          <img src="/icons/arrow.svg" alt="Arrow Icon" class="icon-arrow">
        </div>        
      </div>
    </div>
  </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = [
      { selector: '.card[data-index="0"]', target: '#hruba-stavba' },
      { selector: '.card[data-index="1"]', target: '#strechy' },
      { selector: '.card[data-index="2"]', target: '#other-section' }
    ];

    buttons.forEach(({ selector, target }) => {
      const button = document.querySelector(selector);
      if (button) {
        button.addEventListener('click', () => {
          const targetSection = document.querySelector(target);
          if (targetSection) {
            document.dispatchEvent(new CustomEvent('buttonScrollStart'));
            targetSection.scrollIntoView({ behavior: 'smooth' });
            setTimeout(() => {
              document.dispatchEvent(new CustomEvent('buttonScrollEnd'));
            }, 1000); // Match the duration
          }
        });
      }
    });
  });
</script>

