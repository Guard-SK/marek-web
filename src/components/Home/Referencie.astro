---
import { Image } from "astro:assets";

// Homepage section: 2 project teaser cards + categorized photo gallery
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/gallery/*.{jpeg,jpg,png,gif,avif,webp}",
);

const mainHradok = (await images["../../assets/gallery/main-hradok.avif"]())
  .default;
const fotka1Strechatyp1 = (
  await images["../../assets/gallery/fotka1-strechatyp1.avif"]()
).default;

const galleryCategories = [
  {
    id: "betonaz",
    name: "Betonáž a debnenie",
    photos: Array.from({ length: 9 }, (_, i) => ({
      src: `/gallery/betonaz/${i + 1}.avif`,
      alt: `Betonáž a debnenie - realizácia ${i + 1}`,
    })),
  },
  {
    id: "murovanie",
    name: "Murovanie",
    photos: Array.from({ length: 11 }, (_, i) => ({
      src: `/gallery/murovanie/${i + 1}.avif`,
      alt: `Murovanie - realizácia ${i + 1}`,
    })),
  },
  {
    id: "strechy",
    name: "Strechy a krovy",
    photos: Array.from({ length: 15 }, (_, i) => ({
      src: `/gallery/strechy/${i + 1}.avif`,
      alt: `Strechy a krovy - realizácia ${i + 1}`,
    })),
  },
];
---

<style>
  @keyframes skeletonShimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
  .animate-shimmer {
    animation: skeletonShimmer 1.8s infinite ease-in-out;
  }
</style>

<section
  id="referencie"
  class="bg-[#191919] py-24 px-6 md:px-12 relative overflow-hidden"
>
  <!-- Glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-radial from-[#63ffd3]/8 via-[#39c4ff]/4 to-transparent blur-[130px] pointer-events-none z-0"
  >
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Heading -->
    <div class="text-center mb-12">
      <span
        class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest border border-[#63ffd3]/40 text-[#63ffd3] mb-5"
      >
        Naše realizácie
      </span>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">
        Reálne projekty. Reálni klienti.
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        Pozrite si ukážku toho, čo sme doteraz postavili.
      </p>
    </div>

    <!-- Project cards -->
    <div class="grid md:grid-cols-2 gap-6 mb-20">
      <!-- Card 1: Hrubá stavba -->
      <a
        href="/hruba-stavba#case-study-hradok"
        class="group flex flex-col bg-[#1f1f1f] border border-[#2b2b2b] hover:border-[#63ffd3]/50 rounded-3xl overflow-hidden transition-all duration-300 hover:shadow-[0_20px_60px_rgba(99,255,211,0.07)]"
        aria-label="Pozrieť projekt: Hrubá stavba v Hrádku"
      >
        <div class="relative aspect-video overflow-hidden">
          <Image
            src={mainHradok}
            alt="Hrubá stavba v Hrádku — Aurora Construction"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            width={640}
            height={360}
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6 pointer-events-none"
          >
          </div>
          <span
            class="absolute bottom-4 left-4 bg-gradient-to-r from-[#63ffd3] to-[#39c4ff] text-black text-[10px] font-bold px-3 py-1.5 rounded-full z-10"
          >
            Hrubá stavba
          </span>
        </div>
        <div class="p-6 flex flex-col flex-1">
          <h3
            class="text-white text-xl font-bold mb-2 group-hover:text-[#63ffd3] transition-colors duration-200"
          >
            Hrubá stavba v Hrádku
          </h3>
          <p class="text-gray-400 text-sm mb-5 leading-relaxed md:min-h-[44px]">
            Kompletná realizácia hrubej stavby rodinného domu. Od základov, cez
            murovanie nosných stien, až po krov a strechu.
          </p>
          <div class="flex flex-wrap gap-4 text-sm mb-5 text-gray-300 mt-auto">
            <span
              ><span class="text-[#63ffd3] font-semibold">50 m²</span> zastavaná plocha</span
            >
            <span
              ><span class="text-[#63ffd3] font-semibold">7 týždňov</span> realizácia</span
            >
            <span
              ><span class="text-[#63ffd3] font-semibold">od 20 500 €</span> cena
              práce</span
            >
          </div>
          <span
            class="inline-flex items-center gap-2 text-[#63ffd3] text-sm font-semibold group-hover:gap-3 transition-all duration-200"
          >
            Pozrieť celý projekt
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
        </div>
      </a>

      <!-- Card 2: Strechy -->
      <a
        href="/strechy#case-study-strechy"
        class="group flex flex-col bg-[#1f1f1f] border border-[#2b2b2b] hover:border-[#39c4ff]/50 rounded-3xl overflow-hidden transition-all duration-300 hover:shadow-[0_20px_60px_rgba(57,196,255,0.07)]"
        aria-label="Pozrieť projekt: Sedlová strecha Vinosady"
      >
        <div class="relative aspect-video overflow-hidden">
          <Image
            src={fotka1Strechatyp1}
            alt="Pokládka strešnej krytiny — Aurora Construction"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            width={640}
            height={360}
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6 pointer-events-none"
          >
          </div>
          <span
            class="absolute bottom-4 left-4 bg-gradient-to-r from-[#39c4ff] to-[#63ffd3] text-black text-[10px] font-bold px-3 py-1.5 rounded-full z-10"
          >
            Montáž krytiny
          </span>
        </div>
        <div class="p-6 flex flex-col flex-1">
          <h3
            class="text-white text-xl font-bold mb-2 group-hover:text-[#39c4ff] transition-colors duration-200"
          >
            Sedlová strecha Vinosady
          </h3>
          <p class="text-gray-400 text-sm mb-5 leading-relaxed md:min-h-[44px]">
            Demontáž starej krytiny a pokládka novej krytiny.
          </p>
          <div class="flex flex-wrap gap-4 text-sm mb-5 text-gray-300 mt-auto">
            <span
              ><span class="text-[#39c4ff] font-semibold">224 m²</span> strešná plocha</span
            >
            <span
              ><span class="text-[#39c4ff] font-semibold">8 dní</span> realizácia</span
            >
            <span
              ><span class="text-[#39c4ff] font-semibold">7 000€</span> cena práce</span
            >
          </div>
          <span
            class="inline-flex items-center gap-2 text-[#39c4ff] text-sm font-semibold group-hover:gap-3 transition-all duration-200"
          >
            Pozrieť celý projekt
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
        </div>
      </a>
    </div>

    <!-- Categorized Gallery Showcase -->
    <div id="ukazky-prac" class="border-t border-[#2b2b2b] pt-20 mt-12">
      <div class="text-center mb-14">
        <h3 class="text-3xl md:text-[42px] font-bold text-white tracking-tight leading-tight">
          Ukážky ďalších prác
        </h3>
      </div>

      <!-- Categories Section -->
      <div class="space-y-20">
        {
          galleryCategories.map((cat) => (
            <div id={`kat-${cat.id}`} class="gallery-category-section">
              <!-- Category Header -->
              <div class="flex items-center gap-4 mb-6">
                <div class="h-6 md:h-7 w-1 rounded-full bg-gradient-to-b from-[#63ffd3] to-[#39c4ff]"></div>
                <h4 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
                  {cat.name}
                </h4>
                <div class="flex-1 h-[1px] bg-gradient-to-r from-[#2b2b2b] to-transparent"></div>
              </div>

              <!-- Balanced Grid: No empty slots or orphan photos -->
              <div class="grid grid-cols-2 md:grid-cols-6 gap-3 md:gap-4">
                {cat.photos.map((photo, idx) => {
                  let itemClass =
                    "col-span-1 aspect-square md:col-span-2 md:aspect-[4/3]";

                  if (idx === 0) {
                    itemClass =
                      "col-span-2 aspect-[16/10] md:col-span-2 md:aspect-[4/3]";
                  } else if (cat.id === "murovanie" && idx === 9) {
                    itemClass =
                      "col-span-1 aspect-square md:col-start-2 md:col-span-2 md:aspect-[4/3]";
                  }

                  return (
                    <button
                      type="button"
                      class={`gallery-item-btn relative overflow-hidden rounded-2xl group border border-[#2b2b2b] hover:border-[#63ffd3]/60 transition-all duration-300 shadow-md bg-[#1a1a1a] text-left block w-full focus:outline-none focus:ring-2 focus:ring-[#63ffd3] ${itemClass}`}
                      data-photo-src={photo.src}
                      data-category={cat.name}
                      aria-label={`Zväčšiť fotografiu: ${cat.name}`}
                    >
                      <!-- Lightweight Skeleton Loader -->
                      <div class="absolute inset-0 bg-[#222] pointer-events-none overflow-hidden">
                        <div class="w-full h-full bg-gradient-to-r from-transparent via-white/[0.04] to-transparent animate-shimmer" />
                      </div>

                      <img
                        src={photo.src}
                        alt={photo.alt}
                        class="w-full h-full object-cover transition-[transform,opacity] duration-500 ease-out group-hover:scale-105 relative z-10 opacity-0"
                        loading="lazy"
                        decoding="async"
                        width="500"
                        height="400"
                        onload="this.classList.remove('opacity-0')"
                      />
                      <div class="pointer-events-none absolute inset-0 bg-black/45 opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-out flex items-center justify-center z-20">
                        <div class="w-11 h-11 rounded-full bg-[#161616]/95 border border-[#63ffd3]/40 text-[#63ffd3] shadow-[0_4px_20px_rgba(0,0,0,0.5),0_0_15px_rgba(99,255,211,0.15)] flex items-center justify-center transform-gpu translate-y-2.5 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 ease-out">
                          <svg
                            class="w-5 h-5 transform-gpu transition-transform duration-300 ease-out group-hover:scale-110"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"
                            />
                          </svg>
                        </div>
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- Unified High-Performance Lightbox Modal -->
<div
  id="gallery-lightbox"
  class="fixed inset-0 z-[9999] bg-black/90 backdrop-blur-md hidden flex-col items-center justify-between p-3 md:p-6 transition-all duration-300 select-none"
  role="dialog"
  aria-modal="true"
  aria-label="Prehliadač fotografií"
>
  <!-- Top Bar: Category Indicator Only -->
  <div class="w-full max-w-6xl flex items-center justify-center z-20 px-2 pt-2">
    <div class="flex items-center gap-2 bg-black/60 backdrop-blur-md border border-white/10 px-4 py-1.5 rounded-full">
      <div class="w-1.5 h-1.5 rounded-full bg-[#63ffd3]"></div>
      <span
        id="lightbox-category"
        class="text-xs md:text-sm font-semibold text-white tracking-wide uppercase"
      >
        Kategória
      </span>
    </div>
  </div>

  <!-- Center Image Canvas -->
  <div
    id="lightbox-img-wrapper"
    class="flex-1 flex items-center justify-center min-h-0 w-full px-2 py-3 cursor-pointer"
  >
    <img
      id="lightbox-img"
      src=""
      alt="Zväčšená fotografia"
      class="max-h-full max-w-full object-contain rounded-2xl shadow-2xl transition-all duration-200 cursor-default"
    />
  </div>

  <!-- Bottom Floating Glassy Control Bar (with touch-action: manipulation to prevent double-tap zoom on buttons) -->
  <div class="z-20 pb-3" style="touch-action: manipulation; user-select: none;">
    <div
      class="bg-[#191919]/90 backdrop-blur-xl border border-white/15 px-3 py-1.5 rounded-full flex items-center gap-3 shadow-2xl"
      style="touch-action: manipulation;"
    >
      <button
        id="lightbox-prev"
        type="button"
        class="w-10 h-10 rounded-full bg-white/10 hover:bg-[#63ffd3] hover:text-black text-white active:scale-90 flex items-center justify-center transition-all duration-200 focus:outline-none"
        style="touch-action: manipulation;"
        aria-label="Predchádzajúca fotografia"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="lightbox-next"
        type="button"
        class="w-10 h-10 rounded-full bg-white/10 hover:bg-[#63ffd3] hover:text-black text-white active:scale-90 flex items-center justify-center transition-all duration-200 focus:outline-none"
        style="touch-action: manipulation;"
        aria-label="Nasledujúca fotografia"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <div class="w-px h-5 bg-white/20 mx-0.5" aria-hidden="true"></div>

      <button
        id="lightbox-close"
        type="button"
        class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/25 text-white active:scale-90 flex items-center justify-center transition-all duration-200 focus:outline-none"
        style="touch-action: manipulation;"
        aria-label="Zavrieť galériu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  function initGallery() {
    const lightbox = document.getElementById("gallery-lightbox");
    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement | null;
    const lightboxWrapper = document.getElementById("lightbox-img-wrapper");
    const lightboxCategory = document.getElementById("lightbox-category");
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");

    const itemButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".gallery-item-btn"),
    );

    if (!lightbox || !lightboxImg || itemButtons.length === 0) return;

    let currentIndex = 0;
    const allPhotos = itemButtons.map((btn) => ({
      src: btn.dataset.photoSrc || "",
      category: btn.dataset.category || "",
    }));

    function preload(src: string) {
      if (!src) return;
      const img = new Image();
      img.src = src;
    }

    function showPhoto(index: number) {
      if (index < 0) index = allPhotos.length - 1;
      if (index >= allPhotos.length) index = 0;
      currentIndex = index;

      const photo = allPhotos[currentIndex];
      lightboxImg!.style.opacity = "0.4";
      lightboxImg!.style.transform = "scale(0.98)";
      lightboxImg!.src = photo.src;

      lightboxImg!.onload = () => {
        if (lightboxImg) {
          lightboxImg.style.opacity = "1";
          lightboxImg.style.transform = "scale(1)";
        }
      };

      if (lightboxCategory) lightboxCategory.textContent = photo.category;

      // Preload next and prev images for instant zero-lag switching
      const nextIdx = (currentIndex + 1) % allPhotos.length;
      const prevIdx = (currentIndex - 1 + allPhotos.length) % allPhotos.length;
      preload(allPhotos[nextIdx].src);
      preload(allPhotos[prevIdx].src);
    }

    function openLightbox(index: number) {
      showPhoto(index);
      lightbox!.classList.remove("hidden");
      lightbox!.classList.add("flex");
      document.body.style.overflow = "hidden";
      const navbar = document.getElementById("navbar");
      if (navbar) navbar.style.display = "none";
    }

    function closeLightbox() {
      lightbox!.classList.add("hidden");
      lightbox!.classList.remove("flex");
      document.body.style.overflow = "";
      if (lightboxImg) lightboxImg.src = "";
      const navbar = document.getElementById("navbar");
      if (navbar) navbar.style.display = "";
    }

    itemButtons.forEach((btn, idx) => {
      btn.addEventListener("click", () => openLightbox(idx));
    });

    closeBtn?.addEventListener("click", closeLightbox);
    prevBtn?.addEventListener("click", () => showPhoto(currentIndex - 1));
    nextBtn?.addEventListener("click", () => showPhoto(currentIndex + 1));

    // Close when clicking dark wrapper background (outside the image)
    lightboxWrapper?.addEventListener("click", (e) => {
      if (e.target === lightboxWrapper) closeLightbox();
    });
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // Keyboard navigation
    window.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") showPhoto(currentIndex - 1);
      if (e.key === "ArrowRight") showPhoto(currentIndex + 1);
    });

    // Touch swipe navigation for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    lightbox.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true },
    );
    lightbox.addEventListener(
      "touchend",
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 45) {
          if (diff > 0) showPhoto(currentIndex - 1);
          else showPhoto(currentIndex + 1);
        }
      },
      { passive: true },
    );
  }

  // Support Astro page transitions or direct load
  initGallery();
  document.addEventListener("astro:page-load", initGallery);
</script>
