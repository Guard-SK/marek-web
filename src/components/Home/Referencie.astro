---
import { Image } from 'astro:assets'

// Homepage section: 2 project teaser cards + misc photos strip
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/gallery/*.{jpeg,jpg,png,gif,avif,webp}',
)

const mainHradok = (await images['../../assets/gallery/main-hradok.avif']())
  .default
const fotka1Strechatyp1 = (
  await images['../../assets/gallery/fotka1-strechatyp1.avif']()
).default

const stripPhotosRaw = [
  {
    src: '../../assets/gallery/fotka1-debnenietyp1.avif',
    alt: 'Debnenie a betonáž',
  },
  {
    src: '../../assets/gallery/fotka2-debnenietyp1.avif',
    alt: 'Debnenie — detail',
  },
  {
    src: '../../assets/gallery/fotka1-murovanietyp1.avif',
    alt: 'Murovanie nosných stien',
  },
  {
    src: '../../assets/gallery/fotka1-murovanietyp2.avif',
    alt: 'Murovanie — priečky',
  },
]

const stripPhotos = await Promise.all(
  stripPhotosRaw.map(async (p) => ({
    ...p,
    src: (await images[p.src]()).default,
  })),
)
---

<section
  id="referencie"
  class="bg-[#191919] py-24 px-6 md:px-12 relative overflow-hidden"
>
  <!-- Glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-radial from-[#63ffd3]/8 via-[#39c4ff]/4 to-transparent blur-[130px] pointer-events-none z-0"
  >
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Heading -->
    <div class="text-center mb-12">
      <span
        class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest border border-[#63ffd3]/40 text-[#63ffd3] mb-5"
      >
        Naše realizácie
      </span>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">
        Reálne projekty. Reálni klienti.
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        Každý projekt je záväzok. Pozrite si, čo sme doteraz postavili.
      </p>
    </div>

    <!-- Project cards -->
    <div class="grid md:grid-cols-2 gap-6 mb-16">
      <!-- Card 1: Hrubá stavba -->
      <a
        href="/hruba-stavba#case-study-hradok"
        class="group block bg-[#1f1f1f] border border-[#2b2b2b] hover:border-[#63ffd3]/50 rounded-3xl overflow-hidden transition-all duration-300 hover:shadow-[0_20px_60px_rgba(99,255,211,0.07)]"
        aria-label="Pozrieť projekt: Hrubá stavba v Hrádku"
      >
        <div class="relative aspect-video overflow-hidden">
          <Image
            src={mainHradok}
            alt="Hrubá stavba v Hrádku — Aurora Construction"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            width={640}
            height={360}
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6 pointer-events-none"
          >
          </div>
          <span
            class="absolute bottom-4 left-4 bg-gradient-to-r from-[#63ffd3] to-[#39c4ff] text-black text-[10px] font-bold px-3 py-1.5 rounded-full z-10"
          >
            Hrubá stavba
          </span>
        </div>
        <div class="p-6">
          <h3
            class="text-white text-xl font-bold mb-2 group-hover:text-[#63ffd3] transition-colors duration-200"
          >
            Hrubá stavba v Hrádku
          </h3>
          <p class="text-gray-400 text-sm mb-5 leading-relaxed">
            Kompletná realizácia hrubej stavby rodinného domu — od základov, cez
            murovanie nosných stien, až po uzavretý krov.
          </p>
          <div class="flex flex-wrap gap-4 text-sm mb-5 text-gray-300">
            <span
              ><span class="text-[#63ffd3] font-semibold">50 m²</span> zastavaná plocha</span
            >
            <span
              ><span class="text-[#63ffd3] font-semibold">7 týždňov</span> realizácia</span
            >
            <span
              ><span class="text-[#63ffd3] font-semibold">od 20 500 €</span> cena
              práce</span
            >
          </div>
          <span
            class="inline-flex items-center gap-2 text-[#63ffd3] text-sm font-semibold group-hover:gap-3 transition-all duration-200"
          >
            Pozrieť celý projekt
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
        </div>
      </a>

      <!-- Card 2: Strechy -->
      <a
        href="/strechy#case-study-strechy"
        class="group block bg-[#1f1f1f] border border-[#2b2b2b] hover:border-[#39c4ff]/50 rounded-3xl overflow-hidden transition-all duration-300 hover:shadow-[0_20px_60px_rgba(57,196,255,0.07)]"
        aria-label="Pozrieť projekt: Sedlová strecha Vinosady"
      >
        <div class="relative aspect-video overflow-hidden">
          <Image
            src={fotka1Strechatyp1}
            alt="Pokládka strešnej krytiny — Aurora Construction"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            width={640}
            height={360}
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6 pointer-events-none"
          >
          </div>
          <span
            class="absolute bottom-4 left-4 bg-gradient-to-r from-[#39c4ff] to-[#63ffd3] text-black text-[10px] font-bold px-3 py-1.5 rounded-full z-10"
          >
            Montáž strechy
          </span>
        </div>
        <div class="p-6">
          <h3
            class="text-white text-xl font-bold mb-2 group-hover:text-[#39c4ff] transition-colors duration-200"
          >
            Sedlová strecha — Vinosady
          </h3>
          <p class="text-gray-400 text-sm mb-5 leading-relaxed">
            Kompletná montáž sedlovej strechy vrátane krovu z KVH hranolu,
            latovanie, kontralát a pokládky betónovej krytiny Bramac.
          </p>
          <div class="flex flex-wrap gap-4 text-sm mb-5 text-gray-300">
            <span
              ><span class="text-[#39c4ff] font-semibold">224 m²</span> strešná plocha</span
            >
            <span
              ><span class="text-[#39c4ff] font-semibold">8 dní</span> realizácia</span
            >
            <span
              ><span class="text-[#39c4ff] font-semibold">od 27 800 €</span> cena
              práce</span
            >
          </div>
          <span
            class="inline-flex items-center gap-2 text-[#39c4ff] text-sm font-semibold group-hover:gap-3 transition-all duration-200"
          >
            Pozrieť celý projekt
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
        </div>
      </a>
    </div>

    <!-- Misc work strip -->
    <div class="border-t border-[#2b2b2b] pt-12">
      <p
        class="text-center text-gray-400 text-sm uppercase tracking-widest mb-6"
      >
        Ukážky ďalších prác
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {
          stripPhotos.map((photo) => (
            <div class="relative aspect-square overflow-hidden rounded-2xl group border border-[#2b2b2b] hover:border-[#63ffd3]/40 transition-all duration-500 shadow-lg">
              <Image
                src={photo.src}
                alt={photo.alt}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                width={300}
                height={300}
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-4 pointer-events-none">
                <div class="text-left">
                  <p class="text-[#63ffd3] text-[9px] uppercase tracking-widest font-bold mb-0.5 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
                    Detail práce
                  </p>
                  <h3 class="text-white text-[11px] font-semibold transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500 delay-75 leading-tight">
                    {photo.alt}
                  </h3>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
