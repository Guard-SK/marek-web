<style>
  .img_about {
    background-image: url("/hruba-stavba/Approach.avif");
    background-size: cover;
    background-position: center;
    flex-grow: 1;
    transition: background-position 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Move background image down by 200px between md and lg breakpoints */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .img_about {
      background-position: center -50px;
    }
  }
  @media (min-width: 1024px) {
    .img_about {
      background-position: center;
    }
  }
  article.container h3,
  article.container h2,
  article.container p,
  article.container .shadow-lg,
  .img_about {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }
</style>

<article
  class="container pt-0 px-6 md:p-0 mx-auto mt-12 text-white flex flex-col lg:flex-row gap-4"
>
  <section class="w-full lg:w-3/5 2xl:w-2/3 overflow-hidden">
    <div class="py-6 pt-0 lg:pt-6">
      <h2 class="text-2xl font-bold text-primary gradient-text-2 oswald">
        O nás
      </h2>
      <h3 class="text-4xl md:text-5xl font-bold text-[#E0E0E0]">
        SPOĽAHLIVOSŤ SPOJENÁ S ODBORNOSŤOU
      </h3>
    </div>
    <p class="text-[#B0B0B0] md:text-base text-sm">
      Sme stavebná firma situovaná v Bratislave na výstavbu hrubých stavieb,
      striech a iných konštrukčných riešení. Naša práca spája dôraz na kvalitu a
      detailné remeselné spracovanie. Každý projekt realizujeme so zákazníkom na
      prvom mieste, pričom venujeme maximálnu pozornosť jeho potrebám a
      požiadavkám, pretože veríme, že spokojnosť zákazníka je kľúčom k našej
      úspešnej práci. Naša stavebná firma poskytuje služby primárne v
      Bratislavskom a Trnavskom kraji.
    </p>

    <ol class="flex flex-col md:flex-row gap-4 py-6">
      <li
        class="bg-[#121212] shadow-lg w-full md:w-1/3 p-4 flex flex-col text-center items-center rounded-lg"
      >
        <img
          class="w-8 h-8"
          src="/icons/about-ic1.svg"
          alt="Ikona precíznosti"
          loading="lazy"
          width="32"
          height="32"
        />
        <h4 class="text-base lg:text-lg">
          Precíznosť a spoľahlivosť v každom detaile.
        </h4>
      </li>
      <li
        class="bg-[#121212] shadow-lg w-full md:w-1/3 p-4 flex flex-col text-center items-center rounded-lg"
      >
        <img
          class="w-8 h-8"
          src="/icons/about-ic2.svg"
          alt="Ikona individuálneho prístupu"
          loading="lazy"
          width="32"
          height="32"
        />
        <h4 class="text-base lg:text-lg">
          Individuálny prístup ku každému projektu.
        </h4>
      </li>
      <li
        class="bg-[#121212] shadow-lg w-full md:w-1/3 p-4 flex flex-col text-center items-center rounded-lg"
      >
        <img
          class="w-8 h-8"
          src="/icons/about-ic3.svg"
          alt="Ikona odbornosti"
          loading="lazy"
          width="32"
          height="32"
        />
        <h4 class="text-base lg:text-lg">
          Odborné skúsenosti a moderné postupy.
        </h4>
      </li>
    </ol>
  </section>

  <section
    class="img_about rounded-lg w-full lg:w-2/5 2xl:w-1/3 h-64 lg:h-auto shadow-lg lg:my-6 my-0 bg-white"
    aria-label="Fotografia Aurora Construction tímu"
  >
  </section>
</article>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // 1) Trigger when About comes into view
  ScrollTrigger.create({
    trigger: "article.container",
    start: "top 90%",
    once: true,
    onEnter: () => {
      const tl2 = gsap.timeline({
        defaults: { duration: 0.7, ease: "power2.out" },
      });

      // a) Small title
      tl2.to("article.container h3", { opacity: 1, y: 0 });

      // b) Big heading
      tl2.to("article.container h2", { opacity: 1, y: 0 }, "-=0.4");

      // c) Paragraph copy
      tl2.to("article.container p", { opacity: 1, y: 0 }, "-=0.4");

      // d) The three info cards
      tl2.to(
        "article.container section:first-child .shadow-lg",
        { opacity: 1, y: 0, stagger: 0.15, duration: 0.6 },
        "-=0.3",
      );

      // e) Side image
      tl2.to(".img_about", { opacity: 1, y: 0, duration: 1 }, "-=0.4");
    },
  });
</script>
