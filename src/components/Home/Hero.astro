<section id="hero-home" class="relative overflow-hidden bg-[hsl(0,0%,4%)] text-white flex flex-col lg:flex-row items-center lg:items-end h-auto lg:h-[60vh]">
  <!-- Flex Container with Text -->
  <div class="w-full mx-auto px-6 md:px-12 pt-28 pb-10 lg:pt-32 lg:pb-24 flex flex-col lg:flex-row items-center lg:items-end justify-between gap-12 lg:h-full relative z-10">
    
    <!-- Text Block -->
    <div class="text-center lg:text-left w-full lg:min-w-[400px] max-w-xl z-10 flex-shrink-0">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold leading-tight tracking-tight">
        Spoľahlivá stavebná firma
      </h1>
      <p class="text-gray-300 text-base xl:text-lg mt-6">
        Ponúkame konštrukčné riešenia na mieru v Bratislavskom a Trnavskom kraji – od základov až po elektroinštalácie.
      </p>
      <div class="flex flex-wrap justify-center lg:justify-start gap-2 xl:gap-4 mt-10">
        <a href="/hruba-stavba" class="bg-gradient-to-r from-[#63ffd3] to-[#39c4ff] text-black font-semibold text-sm sm:text-base py-[10px] sm:py-3 px-3 sm:px-4 xl:px-6 rounded-lg sm:rounded-xl shadow-md hover:opacity-90 transition">
          Hrubé stavby
        </a>
        <a href="/strechy" class="bg-gradient-to-r from-[#63ffd3] to-[#39c4ff] text-black font-semibold text-sm sm:text-base py-[10px] sm:py-3 px-3 sm:px-4 xl:px-6 rounded-lg sm:rounded-xl shadow-md hover:opacity-90 transition">
          Strechy
        </a>
        <a href="/elektrika" class="bg-gradient-to-r from-[#63ffd3] to-[#39c4ff] text-black font-semibold text-sm sm:text-base py-[10px] sm:py-3 px-3 sm:px-4 xl:px-6 rounded-lg sm:rounded-xl shadow-md hover:opacity-90 transition">
          Elektrika
        </a>             
      </div>
    </div>
  </div>

  <!-- Image wrapper -->
  <div class="relative w-full h-auto lg:h-[80%] overflow-hidden pointer-events-none z-10">
    <img
      src="/HeroSectionCropped.avif"
      alt="Dvaja pracovníci pri výstavbe hrubej stavby"
      class="w-full lg:w-auto h-auto lg:h-full object-contain max-w-none"
      loading="eager"
      fetchpriority="high"
      width="913"
      height="445"
    />
  </div>

  <!-- Bottom fade only on lg and above -->
  <div class="block absolute bottom-0 left-0 w-full h-32 bg-gradient-to-b from-transparent to-[#191919] z-10 pointer-events-none"></div>

  <!-- Glow (responsive brightness and size) -->
  <div id="glow-effect" class="opacity-0 pointer-events-none absolute bottom-0 right-0 w-[550px] h-[550px] blur-[80px] from-[#63ffd3]/35 via-[#39c4ff]/10 to-transparent lg:w-[800px] lg:h-[800px] lg:blur-[100px] lg:from-[#63ffd3]/50 lg:via-[#39c4ff]/20 bg-gradient-radial z-0"></div>
</section>

<script>
  import gsap from 'gsap';

  window.addEventListener("load", () => {
    // Wait ~500ms to allow LCP to settle
    gsap.to("#glow-effect", {
      opacity: 1,
      duration: 3, // Further increase duration for a longer reveal
      delay: 0.5,
      ease: "power2.inOut" // Use a smoother easing function
    });
  });
</script>