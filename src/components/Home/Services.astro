<head>
  <style>
    .card {
      position: relative;
      width: 100%;
      min-height: 250px;
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      color: white;
      z-index: 1;
      overflow: hidden;
      transition: transform 0.3s ease, height 0.5s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .card::before {
      content: '';
      position: absolute;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: -1;
    }

    .card-1 { background-image: url('/HrubaStavbaCard.avif'); }
    .card-2 { background-image: url('/RoofCard.avif'); }
    .card-3 { background-image: url('/OtherHeroCard.avif'); }

    .icon-arrow {
      position: absolute;
      right: 1.5rem;
      top: 1.5rem;
      width: 32px;
      height: 32px;
      object-fit: contain;
      transition: transform 0.3s ease;
    }

    .card:hover .icon-arrow {
      transform: translateX(5px);
    }

    .extra-text,
    .learn-more-button {
      opacity: 0;
      transform: scale(0.8);
    }

    .learn-more-button {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: linear-gradient(90deg, #06b6d4, #3b82f6);
      color: white;
      border-radius: 9999px;
      font-weight: 600;
      margin-top: 1rem;
      transition: all 0.3s ease;
      text-decoration: none;
    }

    .learn-more-button:hover {
      background: linear-gradient(90deg, #3b82f6, #06b6d4);
      transform: scale(1.1) translateY(-3px);
      box-shadow: 0 8px 20px rgba(59, 130, 246, 0.5);
    }

    .title-text {
      font-weight: 600;
      font-size: 2rem;
      transition: transform 0.3s ease;
    }

    @media (min-width: 640px) {
      .title-text {
        font-size: 2.5rem;
      }
    }
  </style>
</head>

<div>
  <div class="mx-auto sm:mt-24 lg:mt-18 mt-14 pb-14">
    <div class="text-center mb-8">
      <h2 class="font-bold text-5xl lg:text-4xl sm:text-5xl">
        NAŠE <span class="text-primary">SLUŽBY</span>
      </h2>
      <p class="text-[#B0B0B0] text-lg lg:text-md sm:text-lg">
        Stavebné riešenia, ktoré splnia všetky vaše požiadavky
      </p>
    </div>

    <div class="flex flex-col gap-8 items-center">
      <!-- Card 1 -->
      <div id="card-1" class="card card-1" data-index="0">
        <img src="/icons/arrow.svg" alt="Arrow Icon" class="icon-arrow" />
        <p class="title-text text-white">Hrubá stavba</p>
        <p class="extra-text text-white text-lg">
          Zabezpečujeme kompletné riešenia hrubých stavieb od základov až po strechu.
        </p>
        <a href="/hruba-stavba" class="learn-more-button">Chcem vedieť viac</a>
      </div>

      <!-- Card 2 -->
      <div id="card-2" class="card card-2" data-index="1">
        <img src="/icons/arrow.svg" alt="Arrow Icon" class="icon-arrow" />
        <p class="title-text text-white">Strechy</p>
        <p class="extra-text text-white text-lg">
          Navrhujeme a realizujeme kvalitné strechy na mieru pre všetky typy stavieb.
        </p>
        <a href="/strechy" class="learn-more-button">Chcem vedieť viac</a>
      </div>

      <!-- Card 3 -->
      <div id="card-3" class="card card-3" data-index="2">
        <img src="/icons/arrow.svg" alt="Arrow Icon" class="icon-arrow" />
        <p class="title-text text-white">Ostatné práce</p>
        <p class="extra-text text-white text-lg">
          Realizujeme aj rôzne iné stavebné a dokončovacie práce na kľúč.
        </p>
        <a href="/ostatne-prace" class="learn-more-button">Chcem vedieť viac</a>
      </div>
    </div>
  </div>
</div>
