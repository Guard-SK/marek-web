<section class="w-full px-6 sm:px-12 lg:px-24 py-24 bg-[#191919]">
  <div data-service-hero class="text-center mb-8">
    <h2 class="text-4xl sm:text-5xl font-extrabold">
      NAŠE <span class="text-[var(--primary-color)]">SLUŽBY</span>
    </h2>
    <p class="text-[#b0b0b0] text-lg sm:text-xl mt-4">
      Stavebné riešenia, ktoré splnia všetky vaše požiadavky
    </p>
  </div>

  <div class="grid lg:grid-cols-3 gap-8 z-40">
    <!-- Card 1 -->
    <a
      data-service-card
      href="/hruba-stavba"
      class="group relative bg-cover bg-center min-h-[280px] flex flex-col justify-end p-6 rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300"
      style="background-image: url('/HrubaStavbaCard.avif');"
      aria-label="Služba: Hrubá stavba"
    >
      <div
        class="absolute inset-0 bg-black/60 group-hover:bg-black/40 transition-all duration-300"
      >
      </div>
      <div class="relative z-10">
        <h3 class="text-3xl font-bold text-white mb-2">Hrubá stavba</h3>
        <p class="text-white text-base opacity-80">
          Zabezpečujeme kompletné riešenia hrubých stavieb od základov až po
          strechu transparentne a spoľahlivo.
        </p>
        <span
          class="inline-block mt-4 text-sm font-semibold text-[#63ffd3] group-hover:underline"
          >Chcem vedieť viac</span
        >
      </div>
    </a>

    <!-- Card 2 -->
    <a
      data-service-card
      href="/strechy"
      class="group relative bg-cover bg-center min-h-[280px] flex flex-col justify-end p-6 rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300"
      style="background-image: url('/RoofCard.avif');"
      aria-label="Služba: Strechy"
    >
      <div
        class="absolute inset-0 bg-black/60 group-hover:bg-black/40 transition-all duration-300"
      >
      </div>
      <div class="relative z-10">
        <h3 class="text-3xl font-bold text-white mb-2">Strechy</h3>
        <p class="text-white text-base opacity-80">
          Navrhujeme a realizujeme kvalitné strechy na mieru pre všetky typy
          stavieb.
        </p>
        <span
          class="inline-block mt-4 text-sm font-semibold text-[#63ffd3] group-hover:underline"
          >Chcem vedieť viac</span
        >
      </div>
    </a>

    <!-- Card 3 -->
    <div
      data-service-card
      class="group relative bg-cover bg-center min-h-[280px] flex flex-col justify-end p-6 rounded-xl overflow-hidden shadow-md transition-all duration-300"
      style="background-image: url('/Elektrika.avif');"
    >
      <div class="absolute inset-0 bg-black/60 transition-all duration-300">
      </div>
      <div class="relative z-10">
        <h3 class="text-3xl font-bold text-white mb-2">Elektrika</h3>
        <p class="text-white text-base opacity-80">
          Pripravujeme expanziu našich služieb, táto služba je momentálne
          nedostupná
        </p>
        <span class="inline-block mt-4 text-sm font-semibold text-gray-400"
          >Už čoskoro</span
        >
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap'
  import ScrollTrigger from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  // Optimize: Only animate transform/opacity, reduce batch size, and use will-change only for transform/opacity
  gsap.set('[data-service-card]', {
    opacity: 0,
    y: 24,
    willChange: 'opacity, transform',
  })

  ScrollTrigger.batch('[data-service-card]', {
    start: 'top 85%',
    batchMax: 3, // Animate one at a time for smoother experience on mobile
    interval: 0.05,
    once: true,
    onEnter: (batch) => {
      gsap.to(batch, {
        opacity: 1,
        y: 0,
        duration: 0.45,
        ease: 'power1.out',
        stagger: { each: 0.14 },
      })
    },
  })

  // Animate the heading block with lighter animation
  gsap.from('[data-service-hero]', {
    scrollTrigger: {
      trigger: '[data-service-hero]',
      start: 'top 92%',
      toggleActions: 'play none none none',
    },
    opacity: 0,
    y: 16,
    duration: 0.5,
    ease: 'power1.out',
  })
</script>
