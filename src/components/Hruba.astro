---
import ToggleCard from './components/ToggleCard.astro';

const cards = [
  {
    image: '/icons/hrube-ic1.svg',
    title: 'Kvalita, ktorá vydrží',
    description: 'Pri realizácii hrubej stavby používame certifikované materiály a overené technologické postupy. Naši majstri dbajú na maximálnu stabilitu a životnosť stavieb.',
  },
  {
    image: '/icons/hrube-ic2.svg',
    title: 'Rýchlosť a presnosť',
    description: 'Čas sú peniaze. Naša práca je efektívna, no bez kompromisov na kvalite. Priemerná dĺžka výstavby bungalovu je <span class="text-accent">jeden mesiac.</span>',
  },
  {
    image: '/icons/hrube-ic3.svg',
    title: 'Férové ceny',
    description: 'Naším cieľom je spokojnosť, ktorú odporučíte ďalej. <span class="text-accent">Nacenenie je zadarmo</span> a orientačná cena hrubej stavby: <span class="font-semibold">150–210 €/m²</span> (závisí od komplexnosti projektu).',
  },
];
---
  <html lang="sk">
    <head>
      <style>
        .background-container {
          position: relative;
          background: url('/HrubaStavbaCard.avif') no-repeat center center;
          background-size: cover;
          min-height: 100vh;
          display: flex;
          justify-content: center;
          align-items: center;
          overflow: hidden;
        }
      
        .background-overlay {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: linear-gradient(
            to bottom,
            rgba(25, 25, 25, 1) 0%,
            rgba(25, 25, 25, 1) 5%,
            rgba(25, 25, 25, 0.5) 15%,
            rgba(25, 25, 25, 0) 20%,
            rgba(25, 25, 25, 0) 80%,
            rgba(25, 25, 25, 0.5) 85%,
            rgba(25, 25, 25, 1) 95%,
            rgba(25, 25, 25, 1) 100%
          );
          z-index: 1;
        }

        .content {
          position: relative;
          z-index: 2;
          max-width: 1200px;
        }
      
        .hover-card:hover {
          transform: scale(1.05);
          box-shadow: 0 5px 10px rgba(0, 0, 0, 0.3);
        }
      </style>
      
    </head>
    <body class=" ">
      <div class="background-container snap-start scroll-reveal fade-in bg-gradient-to-b from-transparent to-black flex flex-col" id="hruba-stavba">
        <div class="background-overlay"></div>
        <div class="content">
          <article class="container mx-auto text-white flex flex-col items-center justify-center text-center">
            <!-- Textová a kartová sekcia -->
            <section class="w-full overflow-hidden pt-[8rem] pb-[8rem] px-6 flex flex-col items-center justify-center">
              <div class=" bg-[rgb(25,25,25,0.7)] rounded-lg p-6 w-full">
                <h2 class="text-4xl md:text-5xl font-bold text-[#E0E0E0] gradient-text-2 text-left">
                  <strong>Hrubá stavba</strong>
                </h2>
                
                <!-- Popis -->
                <p class="text-white text-sm lg:text-base leading-relaxed mt-4 text-left">
                  Hrubá stavba je základným krokom na ceste k vášmu vysnívanému bývaniu.
                  <br>
                  Naša firma Aurora Construction zabezpečuje všetko od výkopových prác cez realizáciu sietí až po výstavbu základov, obvodových múrov a striech.
                </p>
              </div>
              <!-- Karty -->
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
                {cards.map((card) => (
                  <ToggleCard
                    image={card.image}
                    title={card.title}
                    description={card.description}
                  />
                ))}
              </div>
              <div class="bg-[rgb(25,25,25,0.7)] shadow-lg md:p-8 p-6 rounded-lg mt-6 w-full max-w-2xl text-left">
                <h3 class="md:text-4xl text-3xl font-bold mb-3 text-center gradient-text-1">Ponúkame</h3>
                  
                <ul class="md:text-lg text-base space-y-2 max-w-4xl mx-auto pl-0">
                  <li class="flex items-left space-x-3">
                    <span class="text-white text-xl md:text-2xl">⠕</span>
                    <span class="ml-0">Výstavba základov a hrubej stavby</span>
                  </li>
                  <li class="flex items-left space-x-3">
                    <span class="text-white text-xl md:text-2xl">⠕</span>
                    <span class="ml-0">Jednopodlažné aj viacpodlažné budovy, vrátane podpivničenia</span>
                  </li>
                  <li class="flex items-left space-x-3">
                    <span class="text-white text-xl md:text-2xl">⠕</span>
                    <span class="ml-0 ">Výkopové práce a realizácia sietí (s možnosťou vlastnej montáže)</span>
                  </li>
                  <li class="flex items-left space-x-3">
                    <span class="text-white text-xl md:text-2xl">⠕</span>
                    <span class="ml-0">Kompletné strechy – sedlové, valbové, vrátane krovu</span>
                  </li>
                </ul>
              </div>
            </section>
          </article>
        </div>
      </div>
    </body>
  </html>
