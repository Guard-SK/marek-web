---
 // src/components/Roof/Hero.astro
---
<section id="hero-roof" class="relative h-[52vh] w-full overflow-hidden text-white">
    <!-- Pozadie -->
    <img
      src="/RoofCard.avif"
      width="1536"
      height="800"
      fetchpriority="high"
      loading="eager"
      alt="Montáž dreveného krovu pri stavbe strechy"
      class="absolute inset-0 w-full h-full object-cover z-0"
    />
  
    <!-- Overlay na mobil/tablet -->
    <div class="absolute inset-0 z-10 lg:hidden pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#191919]/90 to-[#191919]"></div>
    </div>
  
    <!-- Dolný fade na desktop -->
    <div class="hidden lg:block absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-[#191919] to-transparent z-10"></div>
  
    <!-- Diagonálny textový box -->
    <div class="hero-diagonal-box absolute inset-0 bg-[#191919] clip-diagonal z-0 flex items-center">
      <div class="max-w-2xl px-6 md:px-10 lg:px-16 py-10 lg:py-0">
        <h1 class="text-3xl lg:text-5xl font-bold leading-tight mb-4">
          Výstavba a rekonštrukcia striech
        </h1>
        <p class="text-lg text-gray-300 mb-6">
          Kompletné riešenia pre nové strechy, rekonštrukciu aj opravy v Bratislave a Trnavskom kraji.
        </p>
        <a
          href="#offer"
          class="inline-block bg-gradient-to-r from-[#63ffd3] to-[#39c4ff] text-black font-semibold py-3 px-6 rounded-xl shadow-xl hover:opacity-90 transition"
        >
          Naša ponuka
        </a>
      </div>
    </div>
  </section>
  
  <style>
    @media (min-width: 1024px) {
    .hero-diagonal-box {
        width: 45%;
        height: 100%;
        background-color: #191919;
        clip-path: polygon(0 0, 100% 0, 80% 100%, 0% 100%);
    }
    }
  </style>
  